{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:plugin-invocation-result:v1alpha1",
  "title": "Infrastructure Intelligence Plugin Invocation Result",
  "description": "A bounded plugin result with stable errors and measured output usage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "PluginInvocationResult"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionId", "tenantId", "pluginId", "pluginVersion", "completedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^pin_[a-f0-9]{32}$"},
        "sessionId": {"type": "string", "pattern": "^psn_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "pluginId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "pluginVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "completedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "usage"],
      "properties": {
        "status": {"type": "string", "enum": ["succeeded", "failed", "cancelled"]},
        "outputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "output": {"type": "object"},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {"code": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128}}
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wallTimeMillis", "outputBytes"],
          "properties": {
            "wallTimeMillis": {"type": "integer", "minimum": 0, "maximum": 3600000},
            "outputBytes": {"type": "integer", "minimum": 0, "maximum": 16777216}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "succeeded"}}}, "then": {"required": ["outputDigest", "output"], "not": {"anyOf": [{"required": ["error"]}]}}},
        {"if": {"properties": {"status": {"enum": ["failed", "cancelled"]}}}, "then": {"required": ["error"], "not": {"anyOf": [{"required": ["outputDigest"]}, {"required": ["output"]}]}}}
      ]
    }
  }
}
