{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:context-evidence-result:v1alpha1",
  "title": "Infrastructure Intelligence Context Evidence Result",
  "description": "Normalized untrusted repository and runbook excerpts stored as Evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ContextEvidenceResult"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "integrationId", "createdAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^ctq_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,128}$"},
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestDigest", "status", "documents", "summary", "warnings"],
      "properties": {
        "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "status": {"type": "string", "enum": ["complete", "partial", "no-data"]},
        "documents": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/document"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["documentCount", "countsByKind"],
          "properties": {
            "documentCount": {"type": "integer", "minimum": 0, "maximum": 32},
            "countsByKind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "runbook": {"type": "integer", "minimum": 1, "maximum": 32},
                "source": {"type": "integer", "minimum": 1, "maximum": 32},
                "configuration": {"type": "integer", "minimum": 1, "maximum": 32},
                "service-catalog": {"type": "integer", "minimum": 1, "maximum": 32}
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["backend-partial", "document-limit", "excerpt-limit"]}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "no-data"}}},
          "then": {
            "properties": {
              "documents": {"maxItems": 0},
              "warnings": {"maxItems": 0},
              "summary": {
                "properties": {
                  "documentCount": {"const": 0},
                  "countsByKind": {"maxProperties": 0}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "complete"}}},
          "then": {
            "properties": {
              "documents": {"minItems": 1},
              "warnings": {"maxItems": 0}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "partial"}}},
          "then": {"properties": {"warnings": {"minItems": 1}}}
        }
      ]
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "referenceId", "resourceRefs", "kind", "title", "locator",
        "revision", "excerpt", "excerptHash", "redactionMethods", "trust",
        "instructionPolicy"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^ctx_[a-f0-9]{32}$"},
        "referenceId": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"},
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "kind": {"type": "string", "enum": ["runbook", "source", "configuration", "service-catalog"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 256},
        "locator": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 8192},
        "excerptHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "redactionMethods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"}
        },
        "trust": {"const": "untrusted"},
        "instructionPolicy": {"const": "data-only"}
      }
    }
  }
}
