{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:plugin-manifest:v1alpha1",
  "title": "Infrastructure Intelligence Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "Plugin"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 128},
        "publisher": {"type": "string", "minLength": 1, "maxLength": 128},
        "description": {"type": "string", "maxLength": 1024}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "entrypoint", "capabilities", "permissions"],
      "properties": {
        "protocolVersion": {"const": "1.0"},
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "target"],
          "properties": {
            "transport": {"type": "string", "enum": ["stdio", "http", "grpc", "wasm"]},
            "target": {"type": "string", "minLength": 1, "maxLength": 512},
            "healthPath": {"type": "string", "pattern": "^/"}
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reference", "digest", "signature"],
          "properties": {
            "type": {"const": "oci-image"},
            "reference": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?:[a-z0-9][a-z0-9._:/-]{0,957}@)?sha256:[a-f0-9]{64}$"},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
            "signature": {
              "oneOf": [
                {
                  "title": "Legacy image-only signature descriptor",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["algorithm", "keyId", "value"],
                  "properties": {
                    "algorithm": {"const": "ed25519"},
                    "keyId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$"},
                    "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
                  }
                },
                {
                  "title": "Manifest-bound execution signature descriptor",
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["profile", "algorithm", "keyId", "manifestDigest", "value"],
                  "properties": {
                    "profile": {"const": "iip.plugin-signature/v2"},
                    "algorithm": {"const": "ed25519"},
                    "keyId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$"},
                    "manifestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
                    "value": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
                  }
                }
              ]
            }
          }
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["resource-observer", "event-source", "evidence-provider", "action-provider", "surface"]
          }
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "method", "inputSchema", "outputSchema"],
            "properties": {
              "capability": {
                "type": "string",
                "enum": ["resource-observer", "event-source", "evidence-provider", "action-provider", "surface"]
              },
              "method": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$"},
              "inputSchema": {"type": "string", "format": "uri-reference", "minLength": 1},
              "outputSchema": {"type": "string", "format": "uri-reference", "minLength": 1}
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["network", "secrets", "resources", "actions"],
          "properties": {
            "network": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "secrets": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}, "uniqueItems": true},
            "resources": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "actions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
          }
        },
        "configSchema": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
