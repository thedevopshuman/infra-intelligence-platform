{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:investigation-request:v1alpha1",
  "title": "Infrastructure Intelligence Investigation Request",
  "description": "A tenant- and actor-scoped request for one bounded investigation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "InvestigationRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"},
        "correlationId": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "trigger", "scope", "budgets", "maxAuthority"],
      "properties": {
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "trigger": {"$ref": "#/$defs/trigger"},
        "scope": {"$ref": "#/$defs/scope"},
        "agentSelector": {"$ref": "#/$defs/agentSelector"},
        "evidenceTypes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"}
        },
        "allowedTools": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"}
        },
        "telemetrySelections": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/telemetrySelection"}
        },
        "kubernetesEventSelections": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/kubernetesEventSelection"}
        },
        "logSelections": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/logSelection"}
        },
        "changeSelections": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/changeSelection"}
        },
        "contextSelections": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/contextSelection"}
        },
        "catalogSnapshot": {
          "$ref": "#/$defs/catalogSnapshot",
          "readOnly": true
        },
        "budgets": {"$ref": "#/$defs/budgets"},
        "maxAuthority": {"type": "string", "enum": ["read", "propose"]},
        "priority": {"type": "string", "enum": ["low", "normal", "high", "critical"]}
      }
    }
  },
  "$defs": {
    "catalogSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "profileId",
        "profileVersion",
        "profileDigest",
        "generatedSelections",
        "snapshotDigest"
      ],
      "properties": {
        "strategy": {"const": "protected-catalog-v1"},
        "profileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "profileVersion": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "profileDigest": {"$ref": "#/$defs/sha256Digest"},
        "generatedSelections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 40,
          "items": {"$ref": "#/$defs/generatedSelection"}
        },
        "snapshotDigest": {"$ref": "#/$defs/sha256Digest"}
      }
    },
    "generatedSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "selectionId"],
      "properties": {
        "signal": {
          "type": "string",
          "enum": [
            "kubernetes.event",
            "repository.context",
            "resource.change",
            "telemetry.metrics",
            "telemetry.logs"
          ]
        },
        "selectionId": {
          "type": "string",
          "pattern": "^(?:kes|xqs|cqs|tqs|lqs)_[a-f0-9]{16}$"
        }
      }
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "summary"],
      "properties": {
        "type": {"type": "string", "enum": ["user", "alert", "event", "scheduled"]},
        "source": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "reference": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "summary": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceUids", "timeRange"],
      "properties": {
        "resourceUids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "timeRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "agentSelector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"}
      }
    },
    "telemetrySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationId", "query", "limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^tqs_[a-f0-9]{16}$"},
        "integrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "rootCauseClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{2,127}$"
          }
        },
        "query": {
          "$ref": "urn:iip:contracts:telemetry-evidence-request:v1alpha1#/$defs/query"
        },
        "limits": {
          "$ref": "urn:iip:contracts:telemetry-evidence-request:v1alpha1#/$defs/limits"
        },
        "interpretation": {
          "$ref": "#/$defs/telemetryInterpretation"
        },
        "baselineComparison": {
          "$ref": "#/$defs/telemetryBaselineComparison"
        },
        "rollingBaselineComparison": {
          "$ref": "#/$defs/telemetryRollingBaselineComparison"
        },
        "seasonalBaselineComparison": {
          "$ref": "#/$defs/telemetrySeasonalBaselineComparison"
        }
      },
      "allOf": [
        {
          "if": {"required": ["interpretation"]},
          "then": {"required": ["rootCauseClasses"]}
        },
        {
          "if": {"required": ["baselineComparison"]},
          "then": {"required": ["rootCauseClasses"]}
        },
        {
          "if": {"required": ["rollingBaselineComparison"]},
          "then": {"required": ["rootCauseClasses"]}
        },
        {
          "if": {"required": ["seasonalBaselineComparison"]},
          "then": {"required": ["rootCauseClasses"]}
        },
        {
          "not": {
            "anyOf": [
              {"required": ["interpretation", "baselineComparison"]},
              {"required": ["interpretation", "rollingBaselineComparison"]},
              {"required": ["interpretation", "seasonalBaselineComparison"]},
              {"required": ["baselineComparison", "rollingBaselineComparison"]},
              {"required": ["baselineComparison", "seasonalBaselineComparison"]},
              {"required": ["rollingBaselineComparison", "seasonalBaselineComparison"]}
            ]
          }
        }
      ]
    },
    "telemetryInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "unit",
        "operator",
        "threshold",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "statistic": {
          "type": "string",
          "enum": ["minimum", "maximum", "mean"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "operator": {
          "type": "string",
          "enum": ["lt", "lte", "gt", "gte"]
        },
        "threshold": {"type": "number"},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "telemetryBaselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "unit",
        "baselineTimeRange",
        "evaluationTimeRange",
        "calculation",
        "operator",
        "threshold",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "statistic": {
          "type": "string",
          "enum": ["minimum", "maximum", "mean"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "baselineTimeRange": {"$ref": "#/$defs/assessmentTimeRange"},
        "evaluationTimeRange": {"$ref": "#/$defs/assessmentTimeRange"},
        "calculation": {
          "type": "string",
          "enum": ["difference", "ratio"]
        },
        "operator": {
          "type": "string",
          "enum": ["lt", "lte", "gt", "gte"]
        },
        "threshold": {"type": "number"},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "telemetryRollingBaselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "unit",
        "baselineDurationSeconds",
        "evaluationDurationSeconds",
        "gapSeconds",
        "calculation",
        "operator",
        "threshold",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "statistic": {
          "type": "string",
          "enum": ["minimum", "maximum", "mean"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "baselineDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "evaluationDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 604800
        },
        "gapSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "calculation": {
          "type": "string",
          "enum": ["difference", "ratio"]
        },
        "operator": {
          "type": "string",
          "enum": ["lt", "lte", "gt", "gte"]
        },
        "threshold": {"type": "number"},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "telemetrySeasonalBaselineComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statistic",
        "unit",
        "periodSeconds",
        "lookbackPeriods",
        "evaluationDurationSeconds",
        "baselineAggregation",
        "calculation",
        "operator",
        "threshold",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "statistic": {
          "type": "string",
          "enum": ["minimum", "maximum", "mean"]
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        },
        "periodSeconds": {
          "type": "integer",
          "minimum": 3600,
          "maximum": 604800
        },
        "lookbackPeriods": {
          "type": "integer",
          "minimum": 2,
          "maximum": 12
        },
        "evaluationDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 86400
        },
        "baselineAggregation": {
          "type": "string",
          "enum": ["mean", "median"]
        },
        "calculation": {
          "type": "string",
          "enum": ["difference", "ratio"]
        },
        "operator": {
          "type": "string",
          "enum": ["lt", "lte", "gt", "gte"]
        },
        "threshold": {"type": "number"},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "calendarAligned": {"const": true},
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        }
      },
      "allOf": [
        {
          "if": {"required": ["calendarAligned"]},
          "then": {
            "required": ["timezone"],
            "properties": {
              "periodSeconds": {"type": "integer", "multipleOf": 86400}
            }
          },
          "else": {"not": {"required": ["timezone"]}}
        }
      ]
    },
    "assessmentTimeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "kubernetesEventSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationId", "query", "limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^kes_[a-f0-9]{16}$"},
        "integrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "rootCauseClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{2,127}$"
          }
        },
        "query": {
          "$ref": "urn:iip:contracts:kubernetes-event-evidence-request:v1alpha1#/$defs/query"
        },
        "limits": {
          "$ref": "urn:iip:contracts:kubernetes-event-evidence-request:v1alpha1#/$defs/limits"
        },
        "interpretation": {"$ref": "#/$defs/kubernetesEventInterpretation"}
      },
      "allOf": [
        {
          "if": {"required": ["interpretation"]},
          "then": {"required": ["rootCauseClasses"]}
        }
      ]
    },
    "kubernetesEventInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "minMatches",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "conditions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{2,127}$"
          }
        },
        "minMatches": {"type": "integer", "minimum": 1, "maximum": 1000},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "logSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationId", "query", "limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^lqs_[a-f0-9]{16}$"},
        "integrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "rootCauseClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{2,127}$"
          }
        },
        "query": {
          "$ref": "urn:iip:contracts:log-evidence-request:v1alpha1#/$defs/query"
        },
        "limits": {
          "$ref": "urn:iip:contracts:log-evidence-request:v1alpha1#/$defs/limits"
        },
        "interpretation": {"$ref": "#/$defs/logInterpretation"}
      },
      "allOf": [
        {
          "if": {"required": ["interpretation"]},
          "then": {"required": ["rootCauseClasses"]}
        }
      ]
    },
    "logInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minRecords",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "minRecords": {"type": "integer", "minimum": 1, "maximum": 1000},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "changeSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationId", "query", "limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^cqs_[a-f0-9]{16}$"},
        "integrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "rootCauseClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{2,127}$"
          }
        },
        "query": {
          "$ref": "urn:iip:contracts:resource-change-evidence-request:v1alpha1#/$defs/query"
        },
        "limits": {
          "$ref": "urn:iip:contracts:resource-change-evidence-request:v1alpha1#/$defs/limits"
        },
        "interpretation": {"$ref": "#/$defs/changeInterpretation"}
      },
      "allOf": [
        {
          "if": {"required": ["interpretation"]},
          "then": {"required": ["rootCauseClasses"]}
        }
      ]
    },
    "changeInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minChanges",
        "whenMatched",
        "whenNotMatched"
      ],
      "properties": {
        "minChanges": {"type": "integer", "minimum": 1, "maximum": 500},
        "whenMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        },
        "whenNotMatched": {
          "type": "string",
          "enum": ["supports", "contradicts", "neutral"]
        }
      }
    },
    "contextSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "integrationId", "query", "limits"],
      "properties": {
        "id": {"type": "string", "pattern": "^xqs_[a-f0-9]{16}$"},
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "rootCauseClasses": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"}
        },
        "query": {"$ref": "urn:iip:contracts:context-evidence-request:v1alpha1#/$defs/query"},
        "limits": {"$ref": "urn:iip:contracts:context-evidence-request:v1alpha1#/$defs/limits"},
        "interpretation": {"$ref": "#/$defs/contextInterpretation"}
      },
      "allOf": [
        {
          "if": {"required": ["interpretation"]},
          "then": {"required": ["rootCauseClasses"]}
        }
      ]
    },
    "contextInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minDocuments", "whenMatched", "whenNotMatched"],
      "properties": {
        "minDocuments": {"type": "integer", "minimum": 1, "maximum": 32},
        "whenMatched": {"type": "string", "enum": ["supports", "contradicts", "neutral"]},
        "whenNotMatched": {"type": "string", "enum": ["supports", "contradicts", "neutral"]}
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxToolCalls",
        "maxWallTimeSeconds",
        "maxModelTokens",
        "maxCostUsd",
        "maxEvidenceItems",
        "maxIterations"
      ],
      "properties": {
        "maxToolCalls": {"type": "integer", "minimum": 0, "maximum": 200},
        "maxWallTimeSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "maxModelTokens": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "maxCostUsd": {"type": "number", "minimum": 0, "maximum": 1000},
        "maxEvidenceItems": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxIterations": {"type": "integer", "minimum": 1, "maximum": 100}
      }
    }
  }
}
