{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-pilot-readiness-report:v1alpha1",
  "title": "Customer Pilot Readiness Report",
  "description": "Privacy-minimized aggregate proving that one exact published and signed release has current local, customer deployment, narrow load, sustained core-workload, planned-failure overlap, and same-invocation AI FinOps evidence before a private design-partner trial.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerPilotReadinessReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "validUntil", "sourceRevision", "sourceDirty"],
      "properties": {
        "id": {"type": "string", "pattern": "^cpr_[a-f0-9]{32}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "sourceRevision": {"$ref": "#/$defs/revision"},
        "sourceDirty": {"const": false}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qualificationLevel", "qualificationBoundary", "subject", "bindings", "objective", "measurements", "evidence", "checks", "limitations", "externalGates", "summary"],
      "properties": {
        "status": {"enum": ["design-partner-candidate", "not-candidate"]},
        "qualificationLevel": {"const": "customer-ai-finops-design-partner-v1"},
        "qualificationBoundary": {"const": "private-design-partner-preflight"},
        "subject": {"$ref": "#/$defs/subject"},
        "bindings": {"$ref": "#/$defs/bindings"},
        "objective": {"$ref": "#/$defs/objective"},
        "measurements": {"$ref": "#/$defs/measurements"},
        "evidence": {"$ref": "#/$defs/evidenceList"},
        "checks": {"$ref": "#/$defs/checks"},
        "limitations": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {"const": "private-design-partner-evaluation-only"},
            {"const": "design-partner-operation-and-acceptance-not-qualified"},
            {"const": "public-license-legal-brand-and-governance-not-qualified"},
            {"const": "invoice-private-rates-discounts-and-commitments-not-qualified"},
            {"const": "customer-approved-private-pilot-core-proxy-not-production-representativeness"},
            {"const": "node-zone-region-and-long-window-slo-not-qualified"},
            {"const": "additional-integrations-models-providers-and-backends-not-qualified"}
          ],
          "items": false
        },
        "externalGates": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {"$ref": "#/$defs/externalGate", "properties": {"id": {"const": "design-partner-operation-and-acceptance"}, "reasonCode": {"const": "customer-pilot-readiness.external.design-partner"}}},
            {"$ref": "#/$defs/externalGate", "properties": {"id": {"const": "customer-production-operating-qualification"}, "reasonCode": {"const": "customer-pilot-readiness.external.production-operations"}}},
            {"$ref": "#/$defs/externalGate", "properties": {"id": {"const": "public-license-legal-brand-and-governance"}, "reasonCode": {"const": "customer-pilot-readiness.external.public-governance"}}}
          ],
          "items": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requiredEvidence", "passedEvidence", "rejectedEvidence", "totalChecks", "passedChecks", "failedChecks", "externalGateCount", "overallStatus"],
          "properties": {
            "requiredEvidence": {"const": 9},
            "passedEvidence": {"type": "integer", "minimum": 0, "maximum": 9},
            "rejectedEvidence": {"type": "integer", "minimum": 0, "maximum": 9},
            "totalChecks": {"const": 21},
            "passedChecks": {"type": "integer", "minimum": 0, "maximum": 21},
            "failedChecks": {"type": "integer", "minimum": 0, "maximum": 21},
            "externalGateCount": {"const": 3},
            "overallStatus": {"enum": ["design-partner-candidate", "not-candidate"]}
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applicationVersion", "chartVersion", "contractsApiVersion", "sourceRevision", "manifestDigest", "controlPlaneImageDigest", "pluginMediationBridgeImageDigest"],
      "properties": {
        "applicationVersion": {"$ref": "#/$defs/semver"},
        "chartVersion": {"$ref": "#/$defs/semver"},
        "contractsApiVersion": {"const": "iip.platform/v1alpha1"},
        "sourceRevision": {"$ref": "#/$defs/revision"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "controlPlaneImageDigest": {"$ref": "#/$defs/digest"},
        "pluginMediationBridgeImageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest", "releaseReadinessReportDigest", "releasePublicationReportDigest", "releaseSignatureReportDigest", "customerDeploymentReportDigest", "controlPlaneLoadReportDigest", "sustainedWorkloadReportDigest", "failureOverlapReportDigest", "aiFinopsPrerequisiteReportDigest", "aiFinopsFlowReportDigest", "signaturePolicyDigest", "publicationTargetSetDigest", "customerEnvironmentSetDigest"],
      "properties": {
        "profileDigest": {"$ref": "#/$defs/digest"},
        "releaseReadinessReportDigest": {"$ref": "#/$defs/digest"},
        "releasePublicationReportDigest": {"$ref": "#/$defs/digest"},
        "releaseSignatureReportDigest": {"$ref": "#/$defs/digest"},
        "customerDeploymentReportDigest": {"$ref": "#/$defs/digest"},
        "controlPlaneLoadReportDigest": {"$ref": "#/$defs/digest"},
        "sustainedWorkloadReportDigest": {"$ref": "#/$defs/digest"},
        "failureOverlapReportDigest": {"$ref": "#/$defs/digest"},
        "aiFinopsPrerequisiteReportDigest": {"$ref": "#/$defs/digest"},
        "aiFinopsFlowReportDigest": {"$ref": "#/$defs/digest"},
        "signaturePolicyDigest": {"$ref": "#/$defs/digest"},
        "publicationTargetSetDigest": {"$ref": "#/$defs/digest"},
        "customerEnvironmentSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumProfileAgeSeconds", "maximumFoundationEvidenceAgeSeconds", "maximumCustomerEvidenceAgeSeconds", "maximumClockSkewSeconds", "reportValiditySeconds"],
      "properties": {
        "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000},
        "maximumFoundationEvidenceAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 2592000},
        "maximumCustomerEvidenceAgeSeconds": {"type": "integer", "minimum": 300, "maximum": 604800},
        "maximumClockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 900},
        "reportValiditySeconds": {"type": "integer", "minimum": 300, "maximum": 604800}
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileReviewedAt", "oldestFoundationEvidenceAt", "newestFoundationEvidenceAt", "oldestCustomerEvidenceAt", "customerDeploymentQualifiedAt", "controlPlaneLoadStartedAt", "controlPlaneLoadCompletedAt", "sustainedWorkloadStartedAt", "sustainedWorkloadCompletedAt", "failureOverlapQualifiedAt", "aiFinopsFlowCompletedAt", "assessedAt", "oldestFoundationEvidenceAgeSeconds", "oldestCustomerEvidenceAgeSeconds"],
      "properties": {
        "profileReviewedAt": {"type": "string", "format": "date-time"},
        "oldestFoundationEvidenceAt": {"type": "string", "format": "date-time"},
        "newestFoundationEvidenceAt": {"type": "string", "format": "date-time"},
        "oldestCustomerEvidenceAt": {"type": "string", "format": "date-time"},
        "customerDeploymentQualifiedAt": {"type": "string", "format": "date-time"},
        "controlPlaneLoadStartedAt": {"type": "string", "format": "date-time"},
        "controlPlaneLoadCompletedAt": {"type": "string", "format": "date-time"},
        "sustainedWorkloadStartedAt": {"type": "string", "format": "date-time"},
        "sustainedWorkloadCompletedAt": {"type": "string", "format": "date-time"},
        "failureOverlapQualifiedAt": {"type": "string", "format": "date-time"},
        "aiFinopsFlowCompletedAt": {"type": "string", "format": "date-time"},
        "assessedAt": {"type": "string", "format": "date-time"},
        "oldestFoundationEvidenceAgeSeconds": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "oldestCustomerEvidenceAgeSeconds": {"type": "integer", "minimum": 0, "maximum": 10000000}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "contractKind", "qualificationBoundary", "reportId", "reportDigest", "observedStatus", "status"],
      "properties": {
        "id": {"enum": ["release-readiness", "registry-publication", "organizational-signatures", "customer-deployment", "control-plane-load", "sustained-core-workload", "customer-failure-overlap", "ai-finops-prerequisites", "same-invocation-ai-finops"]},
        "contractKind": {"enum": ["ReleaseReadinessReport", "ReleasePublicationReport", "ReleaseSignatureVerificationReport", "CustomerDeploymentQualificationReport", "ControlPlaneLoadQualificationReport", "CustomerSustainedWorkloadQualificationReport", "CustomerFailureOverlapQualificationReport", "CustomerAiFinopsPrerequisiteReport", "CustomerAiFinopsFlowQualificationReport"]},
        "qualificationBoundary": {"enum": ["local-candidate", "registry-publication", "organizational-trust", "customer-deployment", "customer-load", "customer-environment-sustained-workload", "customer-environment-planned-failure-overlap", "ai-finops-prerequisites", "same-invocation-customer-runtime"]},
        "reportId": {"type": "string", "pattern": "^[a-z]{3,5}_[a-f0-9]{32}$"},
        "reportDigest": {"$ref": "#/$defs/digest"},
        "observedStatus": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$"},
        "status": {"enum": ["passed", "rejected"]},
        "errorCode": {"type": "string", "pattern": "^customer-pilot-readiness\\.[a-z0-9.-]+$", "maxLength": 160}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "rejected"}}}
      ]
    },
    "evidenceList": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "release-readiness"}, "contractKind": {"const": "ReleaseReadinessReport"}, "qualificationBoundary": {"const": "local-candidate"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "registry-publication"}, "contractKind": {"const": "ReleasePublicationReport"}, "qualificationBoundary": {"const": "registry-publication"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "organizational-signatures"}, "contractKind": {"const": "ReleaseSignatureVerificationReport"}, "qualificationBoundary": {"const": "organizational-trust"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "customer-deployment"}, "contractKind": {"const": "CustomerDeploymentQualificationReport"}, "qualificationBoundary": {"const": "customer-deployment"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "control-plane-load"}, "contractKind": {"const": "ControlPlaneLoadQualificationReport"}, "qualificationBoundary": {"const": "customer-load"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "sustained-core-workload"}, "contractKind": {"const": "CustomerSustainedWorkloadQualificationReport"}, "qualificationBoundary": {"const": "customer-environment-sustained-workload"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "customer-failure-overlap"}, "contractKind": {"const": "CustomerFailureOverlapQualificationReport"}, "qualificationBoundary": {"const": "customer-environment-planned-failure-overlap"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "ai-finops-prerequisites"}, "contractKind": {"const": "CustomerAiFinopsPrerequisiteReport"}, "qualificationBoundary": {"const": "ai-finops-prerequisites"}}},
        {"$ref": "#/$defs/evidence", "properties": {"id": {"const": "same-invocation-ai-finops"}, "contractKind": {"const": "CustomerAiFinopsFlowQualificationReport"}, "qualificationBoundary": {"const": "same-invocation-customer-runtime"}}}
      ],
      "items": false
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "status": {"enum": ["passed", "failed"]},
        "errorCode": {"type": "string", "pattern": "^customer-pilot-readiness\\.[a-z0-9.-]+$", "maxLength": 160}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "failed"}}}
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "prefixItems": [
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "source-binding"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "profile-review"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "evidence-freshness"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "exact-release-identity"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "local-release-readiness"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "registry-publication"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "organizational-signatures"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "customer-deployment"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "control-plane-load"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "sustained-core-workload"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "customer-failure-overlap"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "ai-finops-prerequisites"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "same-invocation-ai-finops"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "publication-signature-chain"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "deployed-image-chain"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "customer-environment-chain"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "sustained-workload-environment-chain"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "failure-overlap-environment-chain"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "post-deployment-load-window"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "post-deployment-sustained-workload-window"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "minimized-output"}}}
      ],
      "items": false
    },
    "externalGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "reasonCode"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "status": {"const": "external-required"},
        "reasonCode": {"type": "string", "pattern": "^customer-pilot-readiness\\.external\\.[a-z0-9.-]+$"}
      }
    }
  }
}
