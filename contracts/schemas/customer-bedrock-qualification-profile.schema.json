{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-bedrock-qualification-profile:v1alpha1",
  "title": "Customer Bedrock Qualification Profile",
  "description": "Protected reviewed selection for one explicitly enabled customer Amazon Bedrock live-provider interoperability call.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerBedrockQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environmentId", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "environmentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "release", "objective"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "modelId", "region", "operation", "credentialsProfile"],
          "properties": {
            "provider": {"const": "aws.bedrock"},
            "modelId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{1,255}$"},
            "region": {"type": "string", "pattern": "^[a-z]{2}(?:-gov)?-[a-z0-9-]{2,24}-[1-9][0-9]?$", "maxLength": 32},
            "operation": {"enum": ["Converse", "ConverseStream"]},
            "credentialsProfile": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"}
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationVersion", "imageDigest"],
          "properties": {
            "applicationVersion": {"$ref": "#/$defs/semver"},
            "imageDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumProviderCallLatencyMilliseconds", "maximumProfileAgeSeconds", "maximumReportAgeSeconds"],
          "properties": {
            "maximumProviderCallLatencyMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 120000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000},
            "maximumReportAgeSeconds": {"type": "integer", "minimum": 300, "maximum": 604800}
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
