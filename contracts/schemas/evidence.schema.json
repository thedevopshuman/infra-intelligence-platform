{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:evidence:v1alpha1",
  "title": "Infrastructure Intelligence Evidence",
  "description": "Tenant-scoped metadata and provenance for one immutable evidence artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "Evidence"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "recordedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^evd_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "recordedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "source",
        "observedAt",
        "retrievedAt",
        "resourceRefs",
        "summary",
        "artifact",
        "handling"
      ],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"},
        "source": {"$ref": "#/$defs/source"},
        "observedAt": {"type": "string", "format": "date-time"},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 4096},
        "summary": {"type": "string", "minLength": 1, "maxLength": 4096},
        "artifact": {"$ref": "#/$defs/artifact"},
        "handling": {"$ref": "#/$defs/handling"}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "integrationId", "locator"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "locator": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "contentHash", "sizeBytes", "storageRef"],
      "properties": {
        "mediaType": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$", "maxLength": 128},
        "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 0, "maximum": 1073741824},
        "storageRef": {"type": "string", "pattern": "^evidence://[a-zA-Z0-9._/-]+$", "maxLength": 2048},
        "encoding": {"type": "string", "enum": ["identity", "gzip", "zstd"]}
      }
    },
    "handling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["redaction", "sensitivity", "retentionClass"],
      "properties": {
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "methods"],
          "properties": {
            "status": {"type": "string", "enum": ["not-required", "applied"]},
            "methods": {
              "type": "array",
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"}
            }
          },
          "allOf": [
            {
              "if": {"properties": {"status": {"const": "applied"}}},
              "then": {"properties": {"methods": {"minItems": 1}}}
            },
            {
              "if": {"properties": {"status": {"const": "not-required"}}},
              "then": {"properties": {"methods": {"maxItems": 0}}}
            }
          ]
        },
        "sensitivity": {"type": "string", "enum": ["public", "internal", "confidential", "restricted"]},
        "retentionClass": {"type": "string", "enum": ["ephemeral", "standard", "extended", "legal-hold"]},
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
