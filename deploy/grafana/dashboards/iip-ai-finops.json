        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showUnfilled": true,
        "valueMode": "color"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (service_name,gen_ai_response_model,cloud_region,deployment_environment_name) (iip_ai_cost_amount{job=\"iip-ai-economics\"}) / 1e9",
          "instant": true,
          "legendFormat": "{{service_name}} · {{gen_ai_response_model}} · {{cloud_region}} · {{deployment_environment_name}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Where is spend happening?",
      "type": "bargauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iip-prometheus"
      },
      "description": "Signed current-versus-baseline input-token growth from the deterministic context-growth rule.",
