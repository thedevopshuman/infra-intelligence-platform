{
  "openapi": "3.1.0",
  "info": {
    "title": "Infrastructure Intelligence Control Plane API",
    "version": "0.4.0",
    "description": "Executable local reference API for collection ingestion, freshness telemetry, backend-neutral metric, log, and Kubernetes Event evidence, tenant-bound OTLP metrics and logs intake, resource queries, investigation-driven event/metric selection and committed-artifact assessment, evidence-backed investigations, governed dry-run actions, and bounded plugin sessions."
  },
  "servers": [{"url": "http://localhost:8080"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {"200": {"description": "Process is healthy"}}
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "security": [],
        "responses": {"200": {"description": "Process is ready"}}
      }
    },
    "/v1/metrics": {
      "post": {
        "operationId": "ingestOtlpMetrics",
        "description": "Optional OTLP/HTTP binary Protobuf receiver. This operation uses a separately configured channel Bearer credential; the global control-plane identity is not accepted.",
        "security": [{"otlpChannelBearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-protobuf": {
              "schema": {"type": "string", "format": "binary"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full OTLP success; the body is a serialized ExportMetricsServiceResponse",
            "content": {"application/x-protobuf": {"schema": {"type": "string", "format": "binary"}}}
          },
          "400": {"$ref": "#/components/responses/OtlpInvalidRequest"},
          "401": {"$ref": "#/components/responses/OtlpUnauthorized"},
          "403": {"$ref": "#/components/responses/OtlpPolicyDenied"},
          "404": {"$ref": "#/components/responses/OtlpReceiverDisabled"},
          "413": {"$ref": "#/components/responses/OtlpRequestTooLarge"},
          "415": {"$ref": "#/components/responses/OtlpUnsupportedMedia"},
          "503": {"$ref": "#/components/responses/OtlpUnavailable"}
        }
      }
    },
    "/v1/logs": {
      "post": {
        "operationId": "ingestOtlpLogs",
        "description": "Optional OTLP/HTTP binary Protobuf logs receiver. This operation uses a separately configured logs-channel Bearer credential; the global control-plane identity is not accepted.",
        "security": [{"otlpChannelBearerAuth": []}],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-protobuf": {
              "schema": {"type": "string", "format": "binary"}
            }
          }
        },
        "responses": {
          "200": {
            "description": "Full OTLP success; the body is a serialized ExportLogsServiceResponse",
            "content": {"application/x-protobuf": {"schema": {"type": "string", "format": "binary"}}}
          },
          "400": {"$ref": "#/components/responses/OtlpInvalidRequest"},
          "401": {"$ref": "#/components/responses/OtlpUnauthorized"},
          "403": {"$ref": "#/components/responses/OtlpPolicyDenied"},
          "404": {"$ref": "#/components/responses/OtlpReceiverDisabled"},
          "413": {"$ref": "#/components/responses/OtlpRequestTooLarge"},
          "415": {"$ref": "#/components/responses/OtlpUnsupportedMedia"},
          "503": {"$ref": "#/components/responses/OtlpUnavailable"}
        }
      }
    },
    "/v1/resources": {
      "get": {
        "operationId": "listResources",
        "responses": {
          "200": {
            "description": "Tenant-scoped resources",
            "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../../contracts/schemas/resource.schema.json"}}}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      },
      "post": {
        "operationId": "ingestResource",
        "parameters": [
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource.schema.json"}}}
        },
        "responses": {
          "202": {"description": "Observation accepted", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/resources/{resourceUid}/neighborhood": {
      "get": {
        "operationId": "getResourceNeighborhood",
        "parameters": [
          {"$ref": "#/components/parameters/ResourceUid"},
          {"name": "depth", "in": "query", "schema": {"type": "integer", "const": 1}, "description": "The v1alpha1 query supports exactly one hop."},
          {"name": "direction", "in": "query", "schema": {"type": "string", "enum": ["incoming", "outgoing", "both"], "default": "both"}},
          {"name": "relationshipType", "in": "query", "style": "form", "explode": true, "schema": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}}},
          {"$ref": "#/components/parameters/PageLimit"},
          {"$ref": "#/components/parameters/PageCursor"}
        ],
        "responses": {
          "200": {"description": "Current tenant-scoped depth-one resource neighborhood", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource-neighborhood.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/resources/{resourceUid}/timeline": {
      "get": {
        "operationId": "getResourceTimeline",
        "parameters": [
          {"$ref": "#/components/parameters/ResourceUid"},
          {"$ref": "#/components/parameters/PageLimit"},
          {"$ref": "#/components/parameters/PageCursor"}
        ],
        "responses": {
          "200": {"description": "Ascending tenant-scoped immutable resource observations", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource-timeline.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/telemetry/ingestion": {
      "get": {
        "operationId": "getIngestionFreshness",
        "parameters": [
          {
            "name": "sourceId",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
          }
        ],
        "responses": {
          "200": {"description": "Point-in-time tenant/source ingestion freshness and delivery-objective evaluation", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/ingestion-freshness-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {
            "description": "No committed source checkpoint exists in the authenticated tenant",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "ingestion.source_not_found"}}}}
          },
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/collections/ingest": {
      "post": {
        "operationId": "ingestResourceCollection",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request", "result"],
            "properties": {
              "request": {"$ref": "../../contracts/schemas/resource-collection-request.schema.json"},
              "result": {"$ref": "../../contracts/schemas/resource-collection-result.schema.json"}
            }
          }}}
        },
        "responses": {
          "202": {
            "description": "Validated observations and any complete-snapshot tombstones are durable; reconciliation membership, aggregate checkpoint, and opaque provider cursor state are committed",
            "content": {"application/json": {"schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items"],
              "properties": {"items": {"type": "array", "items": {"$ref": "../../contracts/schemas/resource.schema.json"}}}
            }}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/evidence/telemetry/queries": {
      "post": {
        "operationId": "collectTelemetryEvidence",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/telemetry-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized metric result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Telemetry request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "telemetry.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The telemetry provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/logs/queries": {
      "post": {
        "operationId": "collectLogEvidence",
        "description": "Collect bounded normalized log evidence for authenticated tenant-scoped resources. The request uses logical services, severities, and attribute filters; provider endpoints, credentials, and vendor query languages remain protected adapter configuration.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/log-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized log result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Log evidence request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "logs.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The log provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/kubernetes/events/queries": {
      "post": {
        "operationId": "collectKubernetesEventEvidence",
        "description": "Collect bounded normalized Kubernetes Event evidence for authenticated tenant-scoped resources. Provider endpoint, TLS, namespace/type allowlists, and credentials are protected integration configuration and never request fields; the default backend returns honest no-data unless the read-only Kubernetes API adapter is selected.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/kubernetes-event-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized Kubernetes Event result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Kubernetes Event request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "kubernetes.event.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The Kubernetes Event provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/{evidenceId}": {
      "get": {
        "operationId": "getEvidence",
        "parameters": [{"name": "evidenceId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^evd_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped evidence metadata", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations": {
      "post": {
        "operationId": "runInvestigation",
        "description": "Run a bounded investigation. Optional Kubernetes Event, metric, and historical log selections inherit authenticated identity, resource/time scope, and investigation tool/evidence budgets before using configured backend-neutral adapters. Root-cause-scoped selections assess only committed normalized artifacts and record supporting, contradicting, neutral, no-data, or incomplete results; deterministic log assessment never interprets body prose.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-request.schema.json"}}}},
        "responses": {
          "201": {"description": "Immutable terminal investigation report", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations/{investigationId}": {
      "get": {
        "operationId": "getInvestigation",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped terminal report", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-report.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions/proposals": {
      "post": {
        "operationId": "proposeAction",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["investigationId", "actionType", "targetResourceUid", "parameters", "idempotencyKey", "expiresAt"], "properties": {"investigationId": {"type": "string"}, "actionType": {"const": "kubernetes.restart-workload"}, "targetResourceUid": {"type": "string"}, "parameters": {"type": "object"}, "idempotencyKey": {"type": "string"}, "expiresAt": {"type": "string", "format": "date-time"}, "dryRun": {"type": "boolean", "default": true}}}}}},
        "responses": {
          "201": {"description": "Immutable action proposal", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/action-proposal.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions/{proposalId}/decision": {
      "post": {
        "operationId": "decideAction",
        "parameters": [{"name": "proposalId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^act_[a-f0-9]{32}$"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["decision", "rationale"], "properties": {"decision": {"type": "string", "enum": ["approved", "rejected"]}, "rationale": {"type": "string"}}}}}},
        "responses": {
          "201": {"description": "Immutable approval decision", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/action-approval.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions/{proposalId}/execute": {
      "post": {
        "operationId": "executeAction",
        "parameters": [{"name": "proposalId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^act_[a-f0-9]{32}$"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "maxProperties": 0}}}},
        "responses": {
          "200": {"description": "Idempotent action result", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/action-result.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions/{proposalId}": {
      "get": {
        "operationId": "getAction",
        "parameters": [{"name": "proposalId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^act_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Proposal or terminal result"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/plugin-sessions": {
      "post": {
        "operationId": "openPluginSession",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "required": ["manifest", "requestedCapabilities", "capabilityToken"], "properties": {"manifest": {"$ref": "../../contracts/schemas/plugin-manifest.schema.json"}, "requestedCapabilities": {"type": "array", "items": {"type": "string"}}, "capabilityToken": {"type": "string", "format": "password", "writeOnly": true}, "limits": {"type": "object"}}}}}},
        "responses": {
          "201": {"description": "Bounded plugin session metadata", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/plugin-session.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/plugin-sessions/{sessionId}": {
      "get": {
        "operationId": "getPluginSession",
        "parameters": [{"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^psn_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped plugin session", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/plugin-session.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer credential verified by the configured authenticator. Tenant, actor, and roles are derived from the verified identity and are never accepted from identity assertion headers."
      },
      "otlpChannelBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent OTLP receiver channel credential. Tenant, integration, resource scope, catalogs, limits, and retention come only from protected channel configuration."
      }
    },
    "parameters": {
      "CorrelationId": {"name": "x-correlation-id", "in": "header", "required": false, "schema": {"type": "string", "minLength": 1}},
      "ResourceUid": {"name": "resourceUid", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}},
      "PageLimit": {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
      "PageCursor": {"name": "cursor", "in": "query", "required": false, "schema": {"type": "string", "pattern": "^p1\\.[A-Za-z0-9_-]+$", "maxLength": 2048}}
    },
    "schemas": {
      "Resource": {"$ref": "../../contracts/schemas/resource.schema.json"},
      "ResourceCollectionRequest": {"$ref": "../../contracts/schemas/resource-collection-request.schema.json"},
      "ResourceCollectionResult": {"$ref": "../../contracts/schemas/resource-collection-result.schema.json"},
      "ResourceNeighborhood": {"$ref": "../../contracts/schemas/resource-neighborhood.schema.json"},
      "ResourceTimeline": {"$ref": "../../contracts/schemas/resource-timeline.schema.json"},
      "IngestionFreshnessReport": {"$ref": "../../contracts/schemas/ingestion-freshness-report.schema.json"},
      "PageInfo": {"$ref": "../../contracts/schemas/page-info.schema.json"},
      "Event": {"$ref": "../../contracts/schemas/event.schema.json"},
      "Evidence": {"$ref": "../../contracts/schemas/evidence.schema.json"},
      "KubernetesEventEvidenceRequest": {"$ref": "../../contracts/schemas/kubernetes-event-evidence-request.schema.json"},
      "KubernetesEventEvidenceResult": {"$ref": "../../contracts/schemas/kubernetes-event-evidence-result.schema.json"},
      "TelemetryEvidenceRequest": {"$ref": "../../contracts/schemas/telemetry-evidence-request.schema.json"},
      "TelemetryEvidenceResult": {"$ref": "../../contracts/schemas/telemetry-evidence-result.schema.json"},
      "OtlpMetricsEvidence": {"$ref": "../../contracts/schemas/otlp-metrics-evidence.schema.json"},
      "InvestigationRequest": {"$ref": "../../contracts/schemas/investigation-request.schema.json"},
      "InvestigationReport": {"$ref": "../../contracts/schemas/investigation-report.schema.json"},
      "IntegrationConfig": {"$ref": "../../contracts/schemas/integration-config.schema.json"},
      "ActionProposal": {"$ref": "../../contracts/schemas/action-proposal.schema.json"},
      "ActionApproval": {"$ref": "../../contracts/schemas/action-approval.schema.json"},
      "ActionResult": {"$ref": "../../contracts/schemas/action-result.schema.json"},
      "PluginSession": {"$ref": "../../contracts/schemas/plugin-session.schema.json"},
      "Error": {"$ref": "../../contracts/schemas/error.schema.json"}
    },
    "responses": {
      "OtlpInvalidRequest": {
        "description": "The OTLP protobuf or normalized metric semantics are invalid",
        "content": {"application/x-protobuf": {"schema": {"type": "string", "format": "binary"}}}
      },
      "OtlpUnauthorized": {
        "description": "The independent receiver channel credential is missing or invalid",
        "headers": {"WWW-Authenticate": {"schema": {"type": "string"}, "example": "Bearer"}},
        "content": {"application/x-protobuf": {"schema": {"type": "string", "format": "binary"}}}
      },
      "OtlpPolicyDenied": {
        "description": "Evidence collection policy denied the configured channel scope",
        "content": {"application/x-protobuf": {"schema": {"type": "string", "format": "binary"}}}
      },
      "OtlpReceiverDisabled": {
