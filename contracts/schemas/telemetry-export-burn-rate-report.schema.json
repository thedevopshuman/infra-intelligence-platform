{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:telemetry-export-burn-rate-report:v1alpha1",
  "title": "Infrastructure Intelligence Telemetry Export Burn-Rate Report",
  "description": "Multi-window error-budget burn rate for deployment-wide OTLP exporter reliability calculated from the same sampled attempt outcomes as the export SLO report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "TelemetryExportBurnRateReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluatedAt"],
      "properties": {
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "objective", "windows", "signals"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "minimumAttainmentBasisPoints",
            "minimumEligibleAttempts",
            "criticalBurnRateHundredths"
          ],
          "properties": {
            "minimumAttainmentBasisPoints": {"type": "integer", "minimum": 1, "maximum": 9999},
            "minimumEligibleAttempts": {"type": "integer", "minimum": 1, "maximum": 1000000},
            "criticalBurnRateHundredths": {"type": "integer", "minimum": 101, "maximum": 1000000}
          }
        },
        "windows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["short", "long"],
          "properties": {
            "short": {"$ref": "#/$defs/window"},
            "long": {"$ref": "#/$defs/window"}
          }
        },
        "signals": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"allOf": [{"$ref": "#/$defs/signal"}, {"properties": {"signal": {"const": "metrics"}}}]},
            {"allOf": [{"$ref": "#/$defs/signal"}, {"properties": {"signal": {"const": "traces"}}}]}
          ],
          "items": false
        }
      }
    }
  },
  "$defs": {
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "status": {
      "type": "string",
      "enum": ["disabled", "no-data", "insufficient-data", "sustainable", "elevated", "critical"]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationSeconds", "start", "end"],
      "properties": {
        "durationSeconds": {"type": "integer", "minimum": 300, "maximum": 2592000},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "windowObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "enabledObservations",
        "eligibleAttempts",
        "successfulAttempts",
        "failedAttempts",
        "attainmentBasisPoints",
        "burnRateHundredths"
      ],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "enabledObservations": {"$ref": "#/$defs/counter"},
        "eligibleAttempts": {"$ref": "#/$defs/counter"},
        "successfulAttempts": {"$ref": "#/$defs/counter"},
        "failedAttempts": {"$ref": "#/$defs/counter"},
        "attainmentBasisPoints": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 10000},
            {"type": "null"}
          ]
        },
        "burnRateHundredths": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["disabled", "no-data"]}}},
          "then": {
            "properties": {
              "eligibleAttempts": {"const": 0},
              "successfulAttempts": {"const": 0},
              "failedAttempts": {"const": 0},
              "attainmentBasisPoints": {"type": "null"},
              "burnRateHundredths": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["insufficient-data", "sustainable", "elevated", "critical"]}}},
          "then": {
            "properties": {
              "enabledObservations": {"minimum": 1},
              "eligibleAttempts": {"minimum": 1},
              "attainmentBasisPoints": {"type": "integer"},
              "burnRateHundredths": {"type": "integer"}
            }
          }
        }
      ]
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "status", "short", "long"],
      "properties": {
        "signal": {"type": "string", "enum": ["metrics", "traces"]},
        "status": {"$ref": "#/$defs/status"},
        "short": {"$ref": "#/$defs/windowObservation"},
        "long": {"$ref": "#/$defs/windowObservation"}
      }
    }
  }
}
