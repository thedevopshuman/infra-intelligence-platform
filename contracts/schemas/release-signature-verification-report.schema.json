{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:release-signature-verification-report:v1alpha1",
  "title": "Release signature verification report",
  "description": "Minimized source-, bundle-, policy-, and digest-bound evidence for verification of the two published IIP OCI indexes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.dev/v1alpha1"},
    "kind": {"const": "ReleaseSignatureVerificationReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "sourceRevision", "sourceDirty"],
      "properties": {
        "id": {"type": "string", "pattern": "^rsv_[a-f0-9]{32}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "sourceDirty": {"type": "boolean"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qualificationLevel", "release", "policy", "environment", "artifacts", "checks", "summary"],
      "properties": {
        "status": {"enum": ["verified", "local-only", "rejected"]},
        "qualificationLevel": {"enum": ["sigstore-keyless-v1", "local-public-key-v1"]},
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "revision", "manifestDigest"],
          "properties": {
            "version": {"$ref": "#/$defs/semver"},
            "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
            "manifestDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "generation", "digest", "cosignVersion"],
          "properties": {
            "id": {"type": "string", "pattern": "^rsp_[a-z0-9][a-z0-9._-]{2,63}$"},
            "generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
            "digest": {"$ref": "#/$defs/digest"},
            "cosignVersion": {"$ref": "#/$defs/strictSemver"}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "pythonVersion", "cosignVersion"],
          "properties": {
            "platform": {"type": "string", "pattern": "^[a-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "pythonVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "cosignVersion": {"$ref": "#/$defs/strictSemver"}
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {"$ref": "#/$defs/artifact", "properties": {"role": {"const": "control-plane-image"}}},
            {"$ref": "#/$defs/artifact", "properties": {"role": {"const": "plugin-mediation-bridge-image"}}}
          ],
          "items": false
        },
        "checks": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "release-bundle-integrity"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "policy-binding"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "immutable-references"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "tool-version"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "control-plane-signature"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "bridge-signature"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "exact-trust"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "transparency-verification"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "secret-minimization"}}}
          ],
          "items": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalChecks", "passedChecks", "failedChecks", "notRunChecks", "overallStatus"],
          "properties": {
            "totalChecks": {"const": 9},
            "passedChecks": {"type": "integer", "minimum": 0, "maximum": 9},
            "failedChecks": {"type": "integer", "minimum": 0, "maximum": 9},
            "notRunChecks": {"type": "integer", "minimum": 0, "maximum": 1},
            "overallStatus": {"enum": ["verified", "local-only", "rejected"]}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "strictSemver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "indexDigest", "trustId", "signatureCount", "status"],
      "properties": {
        "role": {"enum": ["control-plane-image", "plugin-mediation-bridge-image"]},
        "indexDigest": {"$ref": "#/$defs/digest"},
        "trustId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,63}$"},
        "signatureCount": {"type": "integer", "minimum": 0, "maximum": 16},
        "status": {"enum": ["verified", "rejected"]},
        "errorCode": {"type": "string", "pattern": "^release-signature\\.[a-z0-9.-]+$", "maxLength": 128}
      },
      "oneOf": [
        {"properties": {"status": {"const": "verified"}, "signatureCount": {"minimum": 1}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "rejected"}, "signatureCount": {"const": 0}}}
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "status": {"enum": ["passed", "failed", "not-run"]},
        "errorCode": {"type": "string", "pattern": "^release-signature\\.[a-z0-9.-]+$", "maxLength": 128}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"enum": ["failed", "not-run"]}}}
      ]
    }
  }
}
