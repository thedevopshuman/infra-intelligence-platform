{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:resource-change-evidence-request:v1alpha1",
  "title": "Infrastructure Intelligence Resource Change Evidence Request",
  "description": "A bounded request for changes derived from tenant-scoped immutable resource observations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ResourceChangeEvidenceRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^ceq_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrationId", "resourceRefs", "timeRange", "query", "limits", "deadline"],
      "properties": {
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "timeRange": {"$ref": "#/$defs/timeRange"},
        "query": {"$ref": "#/$defs/query"},
        "limits": {"$ref": "#/$defs/limits"},
        "deadline": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changeKinds"],
      "properties": {
        "changeKinds": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["created", "configuration", "image", "scale", "relationships", "status", "deleted"]
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxChanges", "maxObservationsPerResource", "maxBytes"],
      "properties": {
        "maxChanges": {"type": "integer", "minimum": 1, "maximum": 500},
        "maxObservationsPerResource": {"type": "integer", "minimum": 2, "maximum": 1000},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    }
  }
}
