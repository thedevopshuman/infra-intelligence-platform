{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-credential-broker-qualification-profile:v1alpha1",
  "title": "Customer Credential Broker Qualification Profile",
  "description": "Protected reviewed authority cases for qualifying one customer credential broker through the production external client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerCredentialBrokerQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "cases", "objective"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "cases": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "exact-authority"}, "expectedOutcome": {"const": "issued"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "cross-tenant-denial"}, "expectedOutcome": {"const": "denied"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "actor-binding-denial"}, "expectedOutcome": {"const": "denied"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "integration-binding-denial"}, "expectedOutcome": {"const": "denied"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "provider-binding-denial"}, "expectedOutcome": {"const": "denied"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "scope-escalation-denial"}, "expectedOutcome": {"const": "denied"}}},
            {"$ref": "#/$defs/case", "properties": {"id": {"const": "credential-reference-denial"}, "expectedOutcome": {"const": "denied"}}}
          ],
          "items": false
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestTimeoutSeconds", "maximumResponseBytes", "maximumLeaseSeconds", "maximumClockSkewSeconds", "leaseRequestDeadlineSeconds", "maximumLeaseLatencyMilliseconds", "maximumProfileAgeSeconds"],
          "properties": {
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "maximumResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
            "maximumLeaseSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
            "maximumClockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
            "leaseRequestDeadlineSeconds": {"type": "integer", "minimum": 15, "maximum": 900},
            "maximumLeaseLatencyMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000}
          }
        }
      }
    }
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "actorId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$", "not": {"const": "anonymous"}},
    "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
    "credentialRef": {"type": "string", "pattern": "^credential://[A-Za-z0-9._~:/-]{1,2020}$", "maxLength": 2048},
    "provider": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$"},
    "scope": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{0,63}:[a-z][a-z0-9._/-]{0,63}$", "maxLength": 129},
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "actorId", "integrationId", "credentialRef", "provider", "scopes", "expectedOutcome"],
      "properties": {
        "id": {"type": "string"},
        "tenantId": {"$ref": "#/$defs/tenantId"},
        "actorId": {"$ref": "#/$defs/actorId"},
        "integrationId": {"$ref": "#/$defs/integrationId"},
        "credentialRef": {"$ref": "#/$defs/credentialRef"},
        "provider": {"$ref": "#/$defs/provider"},
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope"}
        },
        "expectedOutcome": {"enum": ["issued", "denied"]}
      }
    }
  }
}
