{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-otlp-receiver-qualification-profile:v1alpha1",
  "title": "Customer OTLP Receiver Qualification Profile",
  "description": "Protected exact signal catalog for qualifying a pinned OpenTelemetry Collector against one customer IIP receiver.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerOtlpReceiverQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiverEndpoint", "collector", "signals", "objective"],
      "properties": {
        "receiverEndpoint": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "collector": {
          "type": "object",
          "additionalProperties": false,
          "required": ["distribution", "version", "image"],
          "properties": {
            "distribution": {"const": "opentelemetry-collector-contrib"},
            "version": {"const": "0.158.0"},
            "image": {"const": "otel/opentelemetry-collector-contrib@sha256:c5918f78992ee73b0d6f0e599423ac5ec52dd5d9726733114d6eca53d5a32ed5"}
          }
        },
        "signals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metrics", "logs", "genAiTraces"],
          "properties": {
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "required": ["serviceName", "metricName", "unit"],
              "properties": {
                "serviceName": {"$ref": "#/$defs/name"},
                "metricName": {"type": "string", "pattern": "^[A-Za-z_:][A-Za-z0-9_.:/-]{0,255}$"},
                "unit": {"type": "string", "minLength": 1, "maxLength": 32}
              }
            },
            "logs": {
              "type": "object",
              "additionalProperties": false,
              "required": ["serviceName", "deploymentEnvironment"],
              "properties": {
                "serviceName": {"$ref": "#/$defs/name"},
                "deploymentEnvironment": {"$ref": "#/$defs/name"}
              }
            },
            "genAiTraces": {
              "type": "object",
              "additionalProperties": false,
              "required": ["serviceName", "serviceNamespace", "deploymentEnvironment", "provider", "operation", "requestModel", "responseModel", "region", "instrumentationScope", "semanticConventionVersion"],
              "properties": {
                "serviceName": {"$ref": "#/$defs/name"},
                "serviceNamespace": {"$ref": "#/$defs/name"},
                "deploymentEnvironment": {"$ref": "#/$defs/name"},
                "provider": {"enum": ["aws.bedrock", "openai"]},
                "operation": {"enum": ["chat", "text_completion"]},
                "requestModel": {"$ref": "#/$defs/model"},
                "responseModel": {"$ref": "#/$defs/model"},
                "region": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
                "instrumentationScope": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}[A-Za-z0-9]$", "maxLength": 256},
                "semanticConventionVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$", "maxLength": 64}
              }
            }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestTimeoutSeconds", "deliveryTimeoutSeconds", "pollIntervalMilliseconds", "maximumDeliveryLatencyMilliseconds", "maximumProfileAgeSeconds"],
          "properties": {
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "deliveryTimeoutSeconds": {"type": "integer", "minimum": 10, "maximum": 300},
            "pollIntervalMilliseconds": {"type": "integer", "minimum": 100, "maximum": 5000},
            "maximumDeliveryLatencyMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 300000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000}
          }
        }
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,126}[A-Za-z0-9]$", "maxLength": 128},
    "model": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,254}[A-Za-z0-9]$", "maxLength": 256}
  }
}
