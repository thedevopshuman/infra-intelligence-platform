{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:plugin-invocation:v1alpha1",
  "title": "Infrastructure Intelligence Plugin Invocation",
  "description": "One request-scoped, capability-bound plugin method invocation. Capability bearer material is never part of this document.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "PluginInvocation"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sessionId", "tenantId", "actorId", "createdAt", "deadline"],
      "properties": {
        "id": {"type": "string", "pattern": "^pin_[a-f0-9]{32}$"},
        "sessionId": {"type": "string", "pattern": "^psn_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "actorId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$", "not": {"const": "anonymous"}},
        "createdAt": {"type": "string", "format": "date-time"},
        "deadline": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifestDigest", "capability", "method", "input"],
      "properties": {
        "manifestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "capability": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "method": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{1,63}$"},
        "input": {"type": "object"},
        "mediationGrants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "urn:iip:contracts:plugin-mediation-grant:v1alpha1"}
        }
      }
    }
  }
}
