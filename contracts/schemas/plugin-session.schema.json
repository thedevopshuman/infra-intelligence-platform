{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:plugin-session:v1alpha1",
  "title": "Infrastructure Intelligence Plugin Session",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec", "status"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "PluginSession"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tenantId", "pluginId", "pluginVersion", "createdAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^psn_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "pluginId": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "pluginVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestDigest", "protocolVersion", "grantedCapabilities", "capabilityTokenRef", "capabilityTokenDigest", "expiresAt", "cancellation", "limits"],
      "properties": {
        "manifestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "protocolVersion": {"const": "1.0"},
        "grantedCapabilities": {
          "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"}
        },
        "capabilityTokenRef": {"type": "string", "format": "uri-reference", "pattern": "^capability://", "maxLength": 2048},
        "capabilityTokenDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "cancellation": {
          "type": "object", "additionalProperties": false,
          "required": ["supported", "endpoint"],
          "properties": {
            "supported": {"const": true},
            "endpoint": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048}
          }
        },
        "limits": {
          "type": "object", "additionalProperties": false,
          "required": ["maxRequests", "maxWallTimeSeconds", "maxOutputBytes"],
          "properties": {
            "maxRequests": {"type": "integer", "minimum": 1, "maximum": 10000},
            "maxWallTimeSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
            "maxOutputBytes": {"type": "integer", "minimum": 1024, "maximum": 16777216}
          }
        }
      }
    },
    "status": {"type": "string", "enum": ["ready", "denied"]}
  }
}
