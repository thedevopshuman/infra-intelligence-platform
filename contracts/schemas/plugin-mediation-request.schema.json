{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:plugin-mediation-request:v1alpha1",
  "title": "Infrastructure Intelligence Plugin Mediation Request",
  "description": "One untrusted request over the invocation-local mediation socket. It cannot choose a scheme, host, port, headers, or credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.plugin-runtime/v1alpha1"},
    "kind": {"const": "PluginMediationRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "invocationId", "grantId"],
      "properties": {
        "id": {"type": "string", "pattern": "^pmr_[a-f0-9]{32}$"},
        "invocationId": {"type": "string", "pattern": "^pin_[a-f0-9]{32}$"},
        "grantId": {"type": "string", "pattern": "^pmg_[a-f0-9]{32}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "query"],
      "properties": {
        "method": {"const": "GET"},
        "path": {"type": "string", "pattern": "^/[A-Za-z0-9._~/-]{1,511}$", "maxLength": 512},
        "query": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"},
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "maxLength": 1024, "pattern": "^[^\\x00-\\x1f\\x7f]*$"},
              {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "maxLength": 1024, "pattern": "^[^\\x00-\\x1f\\x7f]*$"}}
            ]
          }
        }
      }
    }
  }
}
