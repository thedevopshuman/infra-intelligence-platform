{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-credential-broker-qualification-report:v1alpha1",
  "title": "Customer Credential Broker Qualification Report",
  "description": "Privacy-minimized evidence that one reviewed customer credential broker enforced the exact IIP authority tuple through the production client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerCredentialBrokerQualificationReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "sourceRevision", "sourceDirty"],
      "properties": {
        "id": {"type": "string", "pattern": "^ccbq_[a-f0-9]{32}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "sourceDirty": {"const": false}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qualification", "subject", "bindings", "profile", "objective", "measurements", "checks", "limitations", "summary"],
      "properties": {
        "status": {"enum": ["qualified", "not-qualified"]},
        "qualification": {"const": "customer-credential-broker-authority-prerequisites-v1"},
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationVersion", "contractsApiVersion", "sourceRevision", "imageDigest"],
          "properties": {
            "applicationVersion": {"$ref": "#/$defs/semver"},
            "contractsApiVersion": {"const": "iip.platform/v1alpha1"},
            "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
            "imageDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "bindings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpointBindingDigest", "profileDigest", "authoritySetDigest", "caBundleDigest"],
          "properties": {
            "endpointBindingDigest": {"$ref": "#/$defs/digest"},
            "profileDigest": {"$ref": "#/$defs/digest"},
            "authoritySetDigest": {"$ref": "#/$defs/digest"},
            "caBundleDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "brokerProtocol", "transport", "identityMode", "leaseScheme", "redirectMode", "proxyMode"],
          "properties": {
            "name": {"const": "customer-external-http-credential-broker-v1"},
            "brokerProtocol": {"const": "iip.broker/v1alpha1"},
            "transport": {"const": "ca-verified-https-json"},
            "identityMode": {"const": "protected-token-file-read-per-request"},
            "leaseScheme": {"const": "bearer"},
            "redirectMode": {"const": "denied"},
            "proxyMode": {"const": "disabled"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestTimeoutSeconds", "maximumResponseBytes", "maximumLeaseSeconds", "maximumClockSkewSeconds", "leaseRequestDeadlineSeconds", "maximumLeaseLatencyMilliseconds", "maximumProfileAgeSeconds"],
          "properties": {
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "maximumResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
            "maximumLeaseSeconds": {"type": "integer", "minimum": 60, "maximum": 3600},
            "maximumClockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
            "leaseRequestDeadlineSeconds": {"type": "integer", "minimum": 15, "maximum": 900},
            "maximumLeaseLatencyMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000}
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileReviewedAt", "startedAt", "completedAt", "caseCount", "issuedCaseCount", "deniedCaseCount", "requestCount", "minimumRemainingLeaseSeconds", "maximumLeaseLatencyMilliseconds"],
          "properties": {
            "profileReviewedAt": {"type": "string", "format": "date-time"},
            "startedAt": {"type": "string", "format": "date-time"},
            "completedAt": {"type": "string", "format": "date-time"},
            "caseCount": {"const": 7},
            "issuedCaseCount": {"const": 1},
            "deniedCaseCount": {"const": 6},
            "requestCount": {"const": 8},
            "minimumRemainingLeaseSeconds": {"type": "integer", "minimum": 0, "maximum": 3900},
            "maximumLeaseLatencyMilliseconds": {"type": "integer", "minimum": 0, "maximum": 30000}
          }
        },
        "checks": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "prefixItems": [
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "profile-binding"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "source-binding"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "protected-input-files"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "endpoint-binding"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "ca-verified-tls"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "workload-identity-accepted"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "exact-authority-issued"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "cross-tenant-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "actor-binding-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "integration-binding-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "provider-binding-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "scope-escalation-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "credential-reference-denied"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "response-correlation"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "lease-bounds"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "repeat-consistency"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "latency-objective"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "minimized-output"}}}
          ],
          "items": false
        },
        "limitations": {
          "type": "array",
          "prefixItems": [
            {"const": "workload-identity-rotation-revocation-and-federation-not-qualified"},
            {"const": "provider-credential-rotation-revocation-and-emergency-access-not-qualified"},
            {"const": "broker-ha-network-certificate-rotation-and-recovery-not-qualified"},
            {"const": "audit-delivery-retention-and-siem-integration-not-qualified"},
            {"const": "non-bearer-provider-credentials-not-qualified"}
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalChecks", "passedChecks", "failedChecks", "overallStatus"],
          "properties": {
            "totalChecks": {"const": 18},
            "passedChecks": {"type": "integer", "minimum": 0, "maximum": 18},
            "failedChecks": {"type": "integer", "minimum": 0, "maximum": 18},
            "overallStatus": {"enum": ["qualified", "not-qualified"]}
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["passed", "failed"]},
        "errorCode": {"type": "string", "pattern": "^customer-credential-broker-qualification\\.[a-z0-9.-]+$", "maxLength": 180}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "failed"}}}
      ]
    }
  }
}
