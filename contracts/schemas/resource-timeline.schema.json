{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:resource-timeline:v1alpha1",
  "title": "Infrastructure Intelligence Resource Timeline",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ResourceTimeline"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "resourceUid"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "resourceUid": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "page"],
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/item"}
        },
        "page": {"$ref": "urn:iip:contracts:page-info:v1alpha1"}
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "recordedAt", "disposition", "observationHash", "resource"],
      "properties": {
        "offset": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "recordedAt": {"type": "string", "format": "date-time"},
        "disposition": {"type": "string", "enum": ["accepted", "stale", "conflict"]},
        "observationHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "resource": {"$ref": "urn:iip:contracts:resource:v1alpha1"}
      }
    }
  }
}
