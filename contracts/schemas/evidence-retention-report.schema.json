{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:evidence-retention-report:v1alpha1",
  "title": "Infrastructure Intelligence Evidence Retention Report",
  "description": "Tenant-scoped observation of deployment-owned Evidence artifact retention policy and lifecycle state.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "EvidenceRetentionReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "evaluatedAt"],
      "properties": {
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "policy", "artifacts"],
      "properties": {
        "status": {"type": "string", "enum": ["disabled", "current", "cleanup-required"]},
        "mode": {"type": "string", "enum": ["observe", "expire"]},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "ephemeralSeconds", "standardSeconds", "extendedSeconds", "batchSize", "digest"],
          "properties": {
            "enabled": {"type": "boolean"},
            "ephemeralSeconds": {"type": "integer", "minimum": 3600, "maximum": 2592000},
            "standardSeconds": {"type": "integer", "minimum": 86400, "maximum": 31536000},
            "extendedSeconds": {"type": "integer", "minimum": 86400, "maximum": 315360000},
            "batchSize": {"type": "integer", "minimum": 1, "maximum": 1000},
            "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storedBefore", "eligible", "expired", "remainingEligible", "legalHold"],
          "properties": {
            "storedBefore": {"$ref": "#/$defs/counter"},
            "eligible": {"$ref": "#/$defs/counter"},
            "expired": {"$ref": "#/$defs/counter"},
            "remainingEligible": {"$ref": "#/$defs/counter"},
            "legalHold": {"$ref": "#/$defs/counter"}
          }
        },
        "auditRef": {"type": "string", "pattern": "^audit://[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}/[a-zA-Z0-9._/-]{1,255}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "observe"}}},
          "then": {
            "properties": {"artifacts": {"properties": {"expired": {"const": 0}}}},
            "not": {"required": ["auditRef"]}
          }
        },
        {
          "if": {"properties": {"mode": {"const": "expire"}}},
          "then": {"properties": {"policy": {"properties": {"enabled": {"const": true}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "disabled"}}},
          "then": {"properties": {"policy": {"properties": {"enabled": {"const": false}}}}}
        },
        {
          "if": {"properties": {"status": {"const": "current"}}},
          "then": {
            "properties": {
              "policy": {"properties": {"enabled": {"const": true}}},
              "artifacts": {"properties": {"remainingEligible": {"const": 0}}}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "cleanup-required"}}},
          "then": {
            "properties": {
              "policy": {"properties": {"enabled": {"const": true}}},
              "artifacts": {"properties": {"remainingEligible": {"minimum": 1}}}
            }
          }
        },
        {
          "if": {
            "properties": {
              "artifacts": {"properties": {"expired": {"minimum": 1}}}
            }
          },
          "then": {"required": ["auditRef"]},
          "else": {"not": {"required": ["auditRef"]}}
        }
      ]
    }
  },
  "$defs": {
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
