{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:integration-config:v1alpha1",
  "title": "Infrastructure Intelligence Integration Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "IntegrationConfig"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "createdAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^int_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "displayName", "enabled", "credentialRef", "collection", "permissions"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 256},
        "enabled": {"type": "boolean"},
        "endpoint": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "credentialRef": {"type": "string", "format": "uri-reference", "pattern": "^(credential|secret-ref)://", "maxLength": 2048},
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "rootExternalId", "mode", "intervalSeconds", "parameters"],
          "properties": {
            "sourceId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
            "rootExternalId": {"type": "string", "minLength": 1, "maxLength": 1024},
            "mode": {"const": "reconciliation"},
            "intervalSeconds": {"type": "integer", "minimum": 15, "maximum": 86400},
            "parameters": {"type": "object", "maxProperties": 32, "additionalProperties": true}
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["readOnly", "resourceTypes"],
          "properties": {
            "readOnly": {"const": true},
            "resourceTypes": {
              "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:/-]{2,127}$"}
            }
          }
        }
      }
    }
  }
}
