{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Infrastructure Intelligence Platform Helm values",
  "description": "Strict customer configuration contract for chart 0.24.x.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "replicaCount",
    "image",
    "worker",
    "eventPublisher",
    "serviceAccount",
    "podSecurityContext",
    "securityContext",
    "service",
    "ingress",
    "config",
    "database",
    "auth",
    "policy",
    "credentialBroker",
    "telemetry",
    "telemetryEvidence",
    "logEvidence",
    "kubernetesEventEvidence",
    "kubernetesActions",
    "contextEvidence",
    "otlpReceiver",
    "otlpLogsReceiver",
    "otlpIngest",
    "resources",
    "probes",
    "networkPolicy",
    "podDisruptionBudget"
  ],
  "properties": {
    "replicaCount": { "$ref": "#/definitions/replicas" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pullPolicy", "tag"],
      "properties": {
        "repository": { "$ref": "#/definitions/nonEmptyString" },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "tag": { "type": "string", "maxLength": 128 }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "replicaCount",
        "tenants",
        "leaseSeconds",
        "heartbeatSeconds",
        "retrySeconds",
        "maxAttempts",
        "actionReconciliationBatchSize",
        "ingestionMonitorTargets",
        "ingestionMonitorIntervalSeconds",
        "resources"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "$ref": "#/definitions/replicas" },
        "tenants": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/tenantId" }
        },
        "leaseSeconds": { "type": "integer", "minimum": 10, "maximum": 300 },
        "heartbeatSeconds": { "type": "integer", "minimum": 0, "maximum": 299 },
        "retrySeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 20 },
        "actionReconciliationBatchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "ingestionMonitorTargets": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["tenantId", "sourceId"],
            "properties": {
              "tenantId": { "$ref": "#/definitions/tenantId" },
              "sourceId": { "$ref": "#/definitions/scopedId" }
            }
          }
        },
        "ingestionMonitorIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "eventPublisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "batchSize",
        "leaseSeconds",
        "retryBaseSeconds",
        "retryMaxSeconds",
        "httpsWebhook"
      ],
      "properties": {
        "mode": { "type": "string", "enum": ["disabled", "https-webhook"] },
        "batchSize": { "type": "integer", "minimum": 1, "maximum": 500 },
        "leaseSeconds": { "type": "integer", "minimum": 5, "maximum": 300 },
        "retryBaseSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "retryMaxSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "httpsWebhook": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "endpoint",
            "timeoutSeconds",
            "maxResponseBytes",
            "tokenExistingSecret",
            "tokenSecretKey",
            "tokenMountPath",
            "caBundleExistingSecret",
            "caBundleSecretKey",
            "caBundleMountPath"
          ],
          "properties": {
            "endpoint": { "$ref": "#/definitions/optionalHttpsUrl" },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
            "maxResponseBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1048576
            },
            "tokenExistingSecret": { "$ref": "#/definitions/optionalName" },
            "tokenSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "tokenMountPath": { "$ref": "#/definitions/absolutePath" },
            "caBundleExistingSecret": { "$ref": "#/definitions/optionalName" },
            "caBundleSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "caBundleMountPath": { "$ref": "#/definitions/absolutePath" }
          }
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": { "name": { "$ref": "#/definitions/nonEmptyString" } }
      }
    },
    "nameOverride": { "type": "string", "maxLength": 63 },
    "fullnameOverride": { "type": "string", "maxLength": 63 },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "automount", "annotations", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "const": false },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "name": { "$ref": "#/definitions/optionalName" }
      }
    },
    "podAnnotations": { "$ref": "#/definitions/stringMap" },
    "podLabels": { "$ref": "#/definitions/stringMap" },
    "podSecurityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup", "fsGroup", "seccompProfile"],
      "properties": {
        "runAsNonRoot": { "const": true },
        "runAsUser": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "runAsGroup": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "fsGroup": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "seccompProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": { "type": { "const": "RuntimeDefault" } }
        }
      }
    },
    "securityContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowPrivilegeEscalation", "readOnlyRootFilesystem", "capabilities"],
      "properties": {
        "allowPrivilegeEscalation": { "const": false },
        "readOnlyRootFilesystem": { "const": true },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": ["drop"],
          "properties": {
            "drop": {
              "type": "array",
              "minItems": 1,
              "contains": { "const": "ALL" },
              "items": { "type": "string" }
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port", "targetPort"],
      "properties": {
        "type": { "const": "ClusterIP" },
        "port": { "$ref": "#/definitions/port" },
        "targetPort": { "const": "http" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "className",
        "annotations",
        "host",
        "path",
        "pathType",
        "tls",
        "tlsRedirectAnnotation",
        "tlsRedirectValue"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "annotations": { "$ref": "#/definitions/stringMap" },
        "host": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "path": { "type": "string", "pattern": "^/", "maxLength": 1024 },
        "pathType": { "type": "string", "enum": ["Prefix", "Exact"] },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingSecret"],
          "properties": {
            "existingSecret": { "$ref": "#/definitions/optionalName" }
          }
        },
        "tlsRedirectAnnotation": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "tlsRedirectValue": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["httpHost", "httpPort"],
      "properties": {
        "httpHost": { "type": "string", "enum": ["0.0.0.0", "::"] },
        "httpPort": { "$ref": "#/definitions/port" }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["existingSecret", "secretKey", "migrations"],
      "properties": {
        "existingSecret": { "$ref": "#/definitions/optionalName" },
        "secretKey": { "$ref": "#/definitions/nonEmptyString" },
        "migrations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "backoffLimit", "activeDeadlineSeconds", "resources"],
          "properties": {
            "enabled": { "type": "boolean" },
            "backoffLimit": { "type": "integer", "minimum": 0, "maximum": 10 },
            "activeDeadlineSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 },
            "resources": { "$ref": "#/definitions/resources" }
          }
        }
      }
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "existingSecret", "secretKey", "oidc"],
      "properties": {
        "mode": { "type": "string", "enum": ["local-hashed", "oidc"] },
        "existingSecret": { "$ref": "#/definitions/optionalName" },
        "secretKey": { "$ref": "#/definitions/nonEmptyString" },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configJson", "caBundleExistingSecret", "caBundleSecretKey", "caBundleMountPath"],
          "properties": {
            "configJson": { "$ref": "#/definitions/jsonString" },
            "caBundleExistingSecret": { "$ref": "#/definitions/optionalName" },
            "caBundleSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "caBundleMountPath": { "$ref": "#/definitions/absolutePath" }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "externalHttp"],
      "properties": {
        "mode": { "type": "string", "enum": ["local", "external-http"] },
        "externalHttp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configJson",
            "bearerTokenExistingSecret",
            "bearerTokenSecretKey",
            "bearerTokenMountPath",
            "caBundleExistingSecret",
            "caBundleSecretKey",
            "caBundleMountPath"
          ],
          "properties": {
            "configJson": { "$ref": "#/definitions/jsonString" },
            "bearerTokenExistingSecret": { "$ref": "#/definitions/optionalName" },
            "bearerTokenSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "bearerTokenMountPath": { "$ref": "#/definitions/absolutePath" },
            "caBundleExistingSecret": { "$ref": "#/definitions/optionalName" },
            "caBundleSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "caBundleMountPath": { "$ref": "#/definitions/absolutePath" }
          }
        }
      }
    },
    "credentialBroker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "externalHttp"],
      "properties": {
        "mode": { "type": "string", "enum": ["static", "external-http"] },
        "externalHttp": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "configJson",
            "audience",
            "tokenExpirationSeconds",
            "identityMountPath",
            "caBundleExistingSecret",
            "caBundleSecretKey",
            "caBundleMountPath"
          ],
          "properties": {
            "configJson": { "$ref": "#/definitions/jsonString" },
            "audience": { "$ref": "#/definitions/nonEmptyString" },
            "tokenExpirationSeconds": { "type": "integer", "minimum": 600, "maximum": 3600 },
            "identityMountPath": { "$ref": "#/definitions/absolutePath" },
            "caBundleExistingSecret": { "$ref": "#/definitions/optionalName" },
            "caBundleSecretKey": { "$ref": "#/definitions/nonEmptyString" },
            "caBundleMountPath": { "$ref": "#/definitions/absolutePath" }
          }
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metricsEnabled",
        "tracesEnabled",
        "otlpEndpoint",
        "protocol",
        "attributeMode",
        "investigationAttributeMode",
        "serviceName",
        "workerServiceName",
        "exportIntervalMillis",
        "exportTimeoutMillis",
        "traceScheduleDelayMillis",
        "traceExportTimeoutMillis",
        "traceMaxQueueSize",
        "traceMaxExportBatchSize",
        "existingSecret",
        "headersSecretKey"
      ],
      "properties": {
        "metricsEnabled": { "type": "boolean" },
        "tracesEnabled": { "type": "boolean" },
        "otlpEndpoint": { "$ref": "#/definitions/optionalHttpUrl" },
        "protocol": { "const": "http/protobuf" },
        "attributeMode": { "type": "string", "enum": ["none", "source", "tenant-source"] },
        "investigationAttributeMode": {
          "type": "string",
          "enum": ["none", "investigation", "tenant-investigation"]
        },
        "serviceName": { "$ref": "#/definitions/serviceName" },
        "workerServiceName": { "$ref": "#/definitions/serviceName" },
        "exportIntervalMillis": { "$ref": "#/definitions/boundedMillis" },
        "exportTimeoutMillis": { "$ref": "#/definitions/boundedMillis" },
        "traceScheduleDelayMillis": { "$ref": "#/definitions/boundedMillis" },
        "traceExportTimeoutMillis": { "$ref": "#/definitions/boundedMillis" },
        "traceMaxQueueSize": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "traceMaxExportBatchSize": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "existingSecret": { "$ref": "#/definitions/optionalName" },
        "headersSecretKey": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "telemetryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "prometheus"],
      "properties": {
        "backend": { "type": "string", "enum": ["no-data", "prometheus"] },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrationsJson", "credentialsExistingSecret", "credentialsSecretKey"],
          "properties": {
            "integrationsJson": { "$ref": "#/definitions/jsonString" },
            "credentialsExistingSecret": { "$ref": "#/definitions/optionalName" },
            "credentialsSecretKey": { "$ref": "#/definitions/nonEmptyString" }
          }
        }
      }
    },
    "logEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "loki"],
      "properties": {
        "backend": { "type": "string", "enum": ["no-data", "loki"] },
        "loki": {
          "type": "object",
          "additionalProperties": false,
          "required": ["integrationsJson", "credentialsExistingSecret", "credentialsSecretKey"],
          "properties": {
            "integrationsJson": { "$ref": "#/definitions/jsonString" },
            "credentialsExistingSecret": { "$ref": "#/definitions/optionalName" },
            "credentialsSecretKey": { "$ref": "#/definitions/nonEmptyString" }
          }
        }
      }
    },
    "kubernetesEventEvidence": { "$ref": "#/definitions/kubernetesEventIntegration" },
    "kubernetesActions": { "$ref": "#/definitions/kubernetesActionIntegration" },
    "contextEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend",
        "integrationsExistingSecret",
        "integrationsSecretKey",
        "documentsExistingConfigMap",
        "documentsMountPath"
      ],
      "properties": {
        "backend": { "type": "string", "enum": ["no-data", "files"] },
        "integrationsExistingSecret": { "$ref": "#/definitions/optionalName" },
        "integrationsSecretKey": { "$ref": "#/definitions/nonEmptyString" },
        "documentsExistingConfigMap": { "$ref": "#/definitions/optionalName" },
        "documentsMountPath": { "$ref": "#/definitions/absolutePath" }
      }
    },
    "otlpReceiver": { "$ref": "#/definitions/receiver" },
    "otlpLogsReceiver": { "$ref": "#/definitions/receiver" },
    "otlpIngest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicaCount",
        "httpHost",
        "httpPort",
        "service",
        "maxRequestsPerSecond",
        "requestBurst",
        "resources"
      ],
      "properties": {
        "replicaCount": { "$ref": "#/definitions/replicas" },
        "httpHost": { "type": "string", "enum": ["0.0.0.0", "::"] },
        "httpPort": { "$ref": "#/definitions/port" },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "port"],
          "properties": {
            "type": { "const": "ClusterIP" },
            "port": { "$ref": "#/definitions/port" }
          }
        },
        "maxRequestsPerSecond": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "requestBurst": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["liveness", "readiness"],
      "properties": {
        "liveness": { "$ref": "#/definitions/basicProbe" },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initialDelaySeconds", "periodSeconds", "timeoutSeconds", "databaseTimeoutSeconds"],
          "properties": {
            "initialDelaySeconds": { "$ref": "#/definitions/nonNegativeSeconds" },
            "periodSeconds": { "$ref": "#/definitions/positiveSeconds" },
            "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 },
            "databaseTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 10 }
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "ingressNamespaceSelector",
        "ingressController",
        "otlpReceiverIngress",
        "databaseEgress",
        "otlpEgress",
        "prometheusEgress",
        "lokiEgress",
        "kubernetesApiEgress",
        "credentialBrokerEgress",
        "oidcEgress",
        "policyEgress",
        "eventPublisherEgress"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressNamespaceSelector": { "$ref": "#/definitions/stringMap" },
        "ingressController": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "$ref": "#/definitions/stringMap" },
            "podSelector": { "$ref": "#/definitions/stringMap" }
          }
        },
        "otlpReceiverIngress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "namespaceSelector", "podSelector"],
          "properties": {
            "enabled": { "type": "boolean" },
            "namespaceSelector": { "$ref": "#/definitions/stringMap" },
            "podSelector": { "$ref": "#/definitions/stringMap" }
          }
        },
        "databaseEgress": { "$ref": "#/definitions/databaseEgress" },
        "otlpEgress": { "$ref": "#/definitions/selectedEgress" },
        "prometheusEgress": { "$ref": "#/definitions/selectedEgress" },
        "lokiEgress": { "$ref": "#/definitions/selectedEgress" },
        "kubernetesApiEgress": { "$ref": "#/definitions/cidrEgress" },
        "credentialBrokerEgress": { "$ref": "#/definitions/cidrEgress" },
        "oidcEgress": { "$ref": "#/definitions/cidrEgress" },
        "policyEgress": { "$ref": "#/definitions/cidrEgress" },
        "eventPublisherEgress": { "$ref": "#/definitions/cidrEgress" }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minAvailable": { "oneOf": [
          { "type": "integer", "minimum": 0, "maximum": 100 },
          { "type": "string", "pattern": "^(100|[0-9]{1,2})%$" }
        ] }
      }
    },
    "nodeSelector": { "$ref": "#/definitions/stringMap" },
    "tolerations": { "type": "array", "maxItems": 64, "items": { "type": "object" } },
    "affinity": { "type": "object" },
    "topologySpreadConstraints": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "object" }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1, "maxLength": 1024 },
    "optionalName": { "type": "string", "maxLength": 253 },
    "absolutePath": { "type": "string", "pattern": "^/", "maxLength": 4096 },
    "jsonString": { "type": "string", "minLength": 2, "maxLength": 1048576 },
    "optionalHttpUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^$|^https?://[^[:space:]?#]+(/[^[:space:]?#]*)?$"
    },
    "optionalHttpsUrl": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^$|^https://[^[:space:]?#]+(/[^[:space:]?#]*)?$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scopedId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "serviceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^[:space:]]+$"
    },
    "replicas": { "type": "integer", "minimum": 1, "maximum": 100 },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "boundedMillis": { "type": "integer", "minimum": 100, "maximum": 300000 },
    "nonNegativeSeconds": { "type": "integer", "minimum": 0, "maximum": 3600 },
    "positiveSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
    "stringMap": {
      "type": "object",
      "maxProperties": 128,
      "additionalProperties": { "type": "string", "maxLength": 1024 }
    },
    "quantityMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "number", "exclusiveMinimum": 0 }] },
        "memory": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "number", "exclusiveMinimum": 0 }] }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "$ref": "#/definitions/quantityMap" },
        "limits": { "$ref": "#/definitions/quantityMap" }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "channelsExistingSecret", "channelsSecretKey"],
      "properties": {
        "enabled": { "type": "boolean" },
        "channelsExistingSecret": { "$ref": "#/definitions/optionalName" },
        "channelsSecretKey": { "$ref": "#/definitions/nonEmptyString" }
      }
    },
    "basicProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialDelaySeconds", "periodSeconds"],
      "properties": {
        "initialDelaySeconds": { "$ref": "#/definitions/nonNegativeSeconds" },
        "periodSeconds": { "$ref": "#/definitions/positiveSeconds" }
      }
    },
    "selectedEgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "port", "namespaceSelector", "podSelector"],
      "properties": {
        "enabled": { "type": "boolean" },
        "port": { "$ref": "#/definitions/port" },
