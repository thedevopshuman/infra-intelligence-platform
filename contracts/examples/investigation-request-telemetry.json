{
  "apiVersion": "iip.platform/v1alpha1",
  "kind": "InvestigationRequest",
  "metadata": {
    "id": "inv_8a31f96b125b4de7a06cc1e942f5d380",
    "tenantId": "local",
    "actorId": "developer",
    "requestedAt": "2026-08-16T09:30:00Z",
    "correlationId": "incident-2026-08-16-checkout-errors"
  },
  "spec": {
    "question": "Did request errors increase while the checkout workload was degraded?",
    "trigger": {
      "type": "alert",
      "source": "urn:iip:event:alertmanager",
      "reference": "alert://local/checkout/error-ratio",
      "summary": "The checkout workload is degraded and its error-ratio alert is firing."
    },
    "scope": {
      "resourceUids": ["res_e0ae9225a316fce4c97df5c23057b97a"],
      "timeRange": {
        "start": "2026-08-16T09:00:00Z",
        "end": "2026-08-16T09:30:00Z"
      }
    },
    "agentSelector": {
      "id": "incident-investigator",
      "version": "0.1.0"
    },
    "evidenceTypes": ["kubernetes.resource-status", "telemetry.metrics"],
    "allowedTools": ["evidence/fetch", "telemetry/query"],
    "telemetrySelections": [
      {
        "id": "tqs_0123456789abcdef",
        "integrationId": "observability-local",
        "rootCauseClasses": ["infrastructure.resource.degraded"],
        "query": {
          "metric": "service.request.error_ratio",
          "filters": [
            {
              "attribute": "service.name",
              "operator": "eq",
              "value": "checkout"
            }
          ],
          "aggregation": {
            "function": "avg",
            "stepSeconds": 60
          },
          "groupBy": ["service.name"]
        },
        "limits": {
          "maxSeries": 8,
          "maxDataPoints": 480,
          "maxBytes": 524288
        }
      }
    ],
    "budgets": {
      "maxToolCalls": 8,
      "maxWallTimeSeconds": 180,
      "maxModelTokens": 50000,
      "maxCostUsd": 1,
      "maxEvidenceItems": 16,
      "maxIterations": 8
    },
    "maxAuthority": "read",
    "priority": "high"
  }
}
