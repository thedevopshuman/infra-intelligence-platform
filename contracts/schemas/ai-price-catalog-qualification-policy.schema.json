{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:ai-price-catalog-qualification-policy:v1alpha1",
  "title": "AI Price Catalog Qualification Policy",
  "description": "Protected tenant policy declaring price-source freshness and exact AI commercial scopes that must resolve uniquely.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "AiPriceCatalogQualificationPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^apqp_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximumSourceAgeSeconds", "reportValiditySeconds", "maximumFutureSkewSeconds", "requiredScopes"],
      "properties": {
        "maximumSourceAgeSeconds": {"type": "integer", "minimum": 300, "maximum": 31536000},
        "reportValiditySeconds": {"type": "integer", "minimum": 60, "maximum": 2592000},
        "maximumFutureSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 300},
        "requiredScopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/scope"}
        }
      }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "modelId", "region", "serviceTier", "routingMode", "purchaseMode", "effectiveAt"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 256},
        "region": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
        "serviceTier": {"enum": ["default", "standard", "flex", "priority", "reserved", "unknown"]},
        "routingMode": {"enum": ["in-region", "geographic", "global", "unknown"]},
        "purchaseMode": {"enum": ["on-demand", "batch", "provisioned-throughput", "unknown"]},
        "effectiveAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
