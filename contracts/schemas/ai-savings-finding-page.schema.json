{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:ai-savings-finding-page:v1alpha1",
  "title": "AI Savings Finding Page",
  "description": "A bounded newest-first page of tenant-scoped AI savings findings evaluated in one exact interval.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "AiSavingsFindingPage"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "generatedAt"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "items", "page"],
      "properties": {
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"}
          }
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "urn:iip:contracts:ai-savings-finding:v1alpha1"}
        },
        "page": {"$ref": "urn:iip:contracts:page-info:v1alpha1"}
      }
    }
  }
}
