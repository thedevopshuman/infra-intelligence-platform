{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:investigation-cancellation-request:v1alpha1",
  "title": "Infrastructure Intelligence Investigation Cancellation Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "InvestigationCancellationRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^can_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["investigationId", "reasonCode"],
      "properties": {
        "investigationId": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"},
        "reasonCode": {
          "type": "string",
          "enum": ["operator-requested", "incident-resolved", "superseded"]
        }
      }
    }
  }
}
