{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:resource:v1alpha1",
  "title": "Infrastructure Intelligence Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "Resource"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "observedAt"],
      "properties": {
        "uid": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "observedAt": {"type": "string", "format": "date-time"},
        "observation": {"$ref": "#/$defs/observation"},
        "labels": {
          "type": "object",
          "additionalProperties": {"type": "string", "maxLength": 256},
          "maxProperties": 64
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "type", "externalId"],
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
        "type": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
        "externalId": {"type": "string", "minLength": 1, "maxLength": 1024},
        "displayName": {"type": "string", "minLength": 1, "maxLength": 512},
        "attributes": {"type": "object", "additionalProperties": true},
        "relationships": {
          "type": "array",
          "maxItems": 512,
          "items": {"$ref": "#/$defs/relationship"}
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "health": {
          "type": "string",
          "enum": ["healthy", "degraded", "unhealthy", "unknown"]
        },
        "lifecycle": {
          "type": "string",
          "enum": ["active", "creating", "updating", "deleting", "deleted", "unknown"]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {
            "required": ["lifecycle"],
            "properties": {"lifecycle": {"const": "deleted"}}
          }
        }
      },
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "attributes": {"maxProperties": 0},
              "relationships": {"maxItems": 0}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "streamId", "sequence", "mode"],
      "properties": {
        "sourceId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "streamId": {"type": "string", "pattern": "^obs_[a-f0-9]{32}$"},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "mode": {"type": "string", "enum": ["incremental", "reconciliation"]},
        "resourceVersion": {"type": "string", "minLength": 1, "maxLength": 512},
        "checkpoint": {"type": "string", "minLength": 1, "maxLength": 2048},
        "snapshotId": {"type": "string", "pattern": "^snap_[a-f0-9]{32}$"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "reconciliation"}}},
          "then": {"required": ["snapshotId"]}
        },
        {
          "if": {"properties": {"mode": {"const": "incremental"}}},
          "then": {"not": {"required": ["snapshotId"]}}
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target"],
      "properties": {
        "type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"},
        "target": {"type": "string", "minLength": 1, "maxLength": 1024},
        "direction": {"type": "string", "enum": ["outbound", "inbound"]},
        "attributes": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
