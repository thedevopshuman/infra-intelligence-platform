          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(iip_ai_cost_amount{iip_ai_currency=\"USD\",iip_ai_currency_scale=\"9\",job=\"iip-ai-economics\"}) / 1e9",
          "instant": true,
          "legendFormat": "USD calculated estimate",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "How much cost?",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iip-prometheus"
      },
      "description": "Calculated estimate grouped only by protected service, model, region, and environment dimensions.",
      "fieldConfig": {
        "defaults": {
          "decimals": 6,
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
