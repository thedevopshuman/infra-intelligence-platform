{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:ai-price-catalog-import-report:v1alpha1",
  "title": "AI Price Catalog Import Report",
  "description": "Minimized reproducibility evidence for one exact provider price source, protected import policy, and generated catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "AiPriceCatalogImportReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "generatedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^apir_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "generatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "sourceProfile", "importerVersion", "source", "policy", "catalog", "measurements", "checks", "summary"],
      "properties": {
        "status": {"const": "imported"},
        "sourceProfile": {"const": "aws-price-list-v1"},
        "importerVersion": {"const": "0.1.0"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceCode", "version", "contentHash", "publicationDate", "retrievedAt", "sizeBytes"],
          "properties": {
            "serviceCode": {"const": "AmazonBedrock"},
            "version": {"type": "string", "pattern": "^[0-9]{8,14}$"},
            "contentHash": {"$ref": "#/$defs/digest"},
            "publicationDate": {"type": "string", "format": "date-time"},
            "retrievedAt": {"type": "string", "format": "date-time"},
            "sizeBytes": {"type": "integer", "minimum": 2, "maximum": 67108864}
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "documentDigest"],
          "properties": {
            "id": {"type": "string", "pattern": "^abp_[a-f0-9]{32}$"},
            "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
            "documentDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "catalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "documentDigest", "currency", "currencyScale", "entryCount"],
          "properties": {
            "id": {"type": "string", "pattern": "^apc_[a-f0-9]{32}$"},
            "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
            "documentDigest": {"$ref": "#/$defs/digest"},
            "currency": {"const": "USD"},
            "currencyScale": {"type": "integer", "enum": [6, 9, 12]},
            "entryCount": {"type": "integer", "minimum": 1, "maximum": 10000}
          }
        },
        "measurements": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rateReferenceCount", "uniquePriceDimensionCount"],
          "properties": {
            "rateReferenceCount": {"type": "integer", "minimum": 5, "maximum": 50000},
            "uniquePriceDimensionCount": {"type": "integer", "minimum": 1, "maximum": 50000}
          }
        },
        "checks": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "source-envelope"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "policy-identity"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "exact-rate-references"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "decimal-conversion"}}},
            {"$ref": "#/$defs/check", "properties": {"id": {"const": "catalog-contract"}}}
          ],
          "items": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalChecks", "passedChecks", "failedChecks", "overallStatus"],
          "properties": {
            "totalChecks": {"const": 5},
            "passedChecks": {"const": 5},
            "failedChecks": {"const": 0},
            "overallStatus": {"const": "imported"}
          }
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string"},
        "status": {"const": "passed"}
      }
    }
  }
}
