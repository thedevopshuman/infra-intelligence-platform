{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:bedrock-invocation-correlation:v1alpha1",
  "title": "Bedrock Invocation Correlation",
  "description": "Ephemeral protected trace/span correlation emitted only when the pinned Bedrock qualifier also exports that exact span to a selected OTLP endpoint.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "BedrockInvocationCorrelation"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedAt", "sourceRevision", "sourceDirty"],
      "properties": {
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "sourceDirty": {"type": "boolean"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "spanId", "deliveryEndpointDigest", "contentCaptured"],
      "properties": {
        "traceId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "spanId": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "deliveryEndpointDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "contentCaptured": {"const": false}
      }
    }
  }
}
