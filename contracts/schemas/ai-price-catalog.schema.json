{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:ai-price-catalog:v1alpha1",
  "title": "AI Price Catalog",
  "description": "A tenant-scoped, versioned snapshot of data-driven generative-AI token prices.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "AiPriceCatalog"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "version", "publishedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^apc_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
        "publishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "currencyScale", "source", "entries"],
      "properties": {
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$"},
        "currencyScale": {"type": "integer", "enum": [6, 9, 12]},
        "source": {"$ref": "#/$defs/source"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/entry"}
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "retrievedAt", "contentHash"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["provider-published", "operator-managed", "test-fixture"]
        },
        "locator": {
          "type": "string",
          "format": "uri-reference",
          "minLength": 1,
          "maxLength": 2048
        },
        "retrievedAt": {"type": "string", "format": "date-time"},
        "contentHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["priceSubunitsPerMillionTokens"],
      "properties": {
        "priceSubunitsPerMillionTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "rates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uncachedInputTokens",
        "cacheReadInputTokens",
        "cacheWriteInputTokens",
        "nonReasoningOutputTokens",
        "reasoningOutputTokens"
      ],
      "properties": {
        "uncachedInputTokens": {"$ref": "#/$defs/price"},
        "cacheReadInputTokens": {"$ref": "#/$defs/price"},
        "cacheWriteInputTokens": {"$ref": "#/$defs/price"},
        "nonReasoningOutputTokens": {"$ref": "#/$defs/price"},
        "reasoningOutputTokens": {"$ref": "#/$defs/price"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "modelId",
        "regions",
        "serviceTiers",
        "routingModes",
        "purchaseModes",
        "effectiveFrom",
        "rates"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "modelId": {"type": "string", "minLength": 1, "maxLength": 256},
        "regions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"}
        },
        "serviceTiers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["default", "standard", "flex", "priority", "reserved", "unknown"]
          }
        },
        "routingModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["in-region", "geographic", "global", "unknown"]
          }
        },
        "purchaseModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["on-demand", "batch", "provisioned-throughput", "unknown"]
          }
        },
        "effectiveFrom": {"type": "string", "format": "date-time"},
        "effectiveUntil": {"type": "string", "format": "date-time"},
        "rates": {"$ref": "#/$defs/rates"}
      }
    }
  }
}
