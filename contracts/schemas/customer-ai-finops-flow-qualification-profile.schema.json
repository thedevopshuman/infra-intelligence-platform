{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-ai-finops-flow-qualification-profile:v1alpha1",
  "title": "Customer AI FinOps Flow Qualification Profile",
  "description": "Protected reviewed selection for one same-invocation Bedrock-to-dashboard customer qualification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerAiFinopsFlowQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environmentId", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "environmentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "prerequisites", "bedrock", "collection", "attribution", "targets", "presentation", "objective"],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationVersion", "chartVersion", "sourceRevision", "imageDigest"],
          "properties": {
            "applicationVersion": {"$ref": "#/$defs/semver"},
            "chartVersion": {"$ref": "#/$defs/semver"},
            "sourceRevision": {"$ref": "#/$defs/revision"},
            "imageDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "prerequisites": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileDigest", "reportDigest"],
          "properties": {
            "profileDigest": {"$ref": "#/$defs/digest"},
            "reportDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "bedrock": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileDigest"],
          "properties": {"profileDigest": {"$ref": "#/$defs/digest"}}
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "operation", "requestPath", "telemetryPath", "contentPolicy", "qualificationServiceName"],
          "properties": {
            "provider": {"const": "aws.bedrock"},
            "operation": {"const": "ConverseStream"},
            "requestPath": {"const": "direct-to-provider"},
            "telemetryPath": {"const": "asynchronous-otel"},
            "contentPolicy": {"const": "metadata-only"},
            "qualificationServiceName": {"const": "iip-bedrock-compatibility"}
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationId", "teamId"],
          "properties": {
            "applicationId": {"$ref": "#/$defs/safeId"},
            "teamId": {"$ref": "#/$defs/safeId"}
          }
        },
        "targets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controlPlaneBaseUrl", "otlpTracesEndpoint", "prometheusBaseUrl", "grafanaBaseUrl"],
          "properties": {
            "controlPlaneBaseUrl": {"type": "string", "format": "uri", "maxLength": 2048},
            "otlpTracesEndpoint": {"type": "string", "format": "uri", "maxLength": 2048},
            "prometheusBaseUrl": {"type": "string", "format": "uri", "maxLength": 2048},
            "grafanaBaseUrl": {"type": "string", "format": "uri", "maxLength": 2048}
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["telemetryBackend", "dashboard", "dashboardUid"],
          "properties": {
            "telemetryBackend": {"const": "prometheus"},
            "dashboard": {"const": "grafana"},
            "dashboardUid": {"const": "iip-ai-finops"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumProfileAgeSeconds", "maximumPrerequisiteAgeSeconds", "maximumClockSkewSeconds", "maximumEndToEndLatencyMilliseconds", "pollIntervalMilliseconds", "requestTimeoutSeconds", "reportValiditySeconds"],
          "properties": {
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000},
            "maximumPrerequisiteAgeSeconds": {"type": "integer", "minimum": 300, "maximum": 604800},
            "maximumClockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 900},
            "maximumEndToEndLatencyMilliseconds": {"type": "integer", "minimum": 10000, "maximum": 900000},
            "pollIntervalMilliseconds": {"type": "integer", "minimum": 250, "maximum": 5000},
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "reportValiditySeconds": {"type": "integer", "minimum": 300, "maximum": 604800}
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "safeId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
  }
}
