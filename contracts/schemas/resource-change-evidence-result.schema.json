{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:resource-change-evidence-result:v1alpha1",
  "title": "Infrastructure Intelligence Resource Change Evidence Result",
  "description": "Normalized resource changes derived from immutable observation history and stored as Evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ResourceChangeEvidenceResult"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "integrationId", "createdAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^ceq_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "createdAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestDigest", "timeRange", "status", "changes", "summary", "warnings"],
      "properties": {
        "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "timeRange": {"$ref": "#/$defs/timeRange"},
        "status": {"type": "string", "enum": ["complete", "partial", "no-data"]},
        "changes": {
          "type": "array",
          "maxItems": 500,
          "items": {"$ref": "#/$defs/change"}
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changeCount", "affectedResourceCount", "countsByKind"],
          "properties": {
            "changeCount": {"type": "integer", "minimum": 0, "maximum": 500},
            "affectedResourceCount": {"type": "integer", "minimum": 0, "maximum": 32},
            "countsByKind": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "created": {"type": "integer", "minimum": 1, "maximum": 500},
                "configuration": {"type": "integer", "minimum": 1, "maximum": 500},
                "image": {"type": "integer", "minimum": 1, "maximum": 500},
                "scale": {"type": "integer", "minimum": 1, "maximum": 500},
                "relationships": {"type": "integer", "minimum": 1, "maximum": 500},
                "status": {"type": "integer", "minimum": 1, "maximum": 500},
                "deleted": {"type": "integer", "minimum": 1, "maximum": 500}
              }
            }
          }
        },
        "warnings": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["observation-limit", "change-limit"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"spec": {"properties": {"status": {"const": "complete"}}}}},
      "then": {"properties": {"spec": {"properties": {"changes": {"minItems": 1}, "warnings": {"maxItems": 0}}}}}
    },
    {
      "if": {"properties": {"spec": {"properties": {"status": {"const": "partial"}}}}},
      "then": {"properties": {"spec": {"properties": {"warnings": {"minItems": 1}}}}}
    },
    {
      "if": {"properties": {"spec": {"properties": {"status": {"const": "no-data"}}}}},
      "then": {
        "properties": {
          "spec": {
            "properties": {
              "changes": {"maxItems": 0},
              "warnings": {"maxItems": 0},
              "summary": {
                "properties": {
                  "changeCount": {"const": 0},
                  "affectedResourceCount": {"const": 0},
                  "countsByKind": {"maxProperties": 0}
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceRef", "kind", "observedAt", "recordedAt", "afterObservationHash", "changedPaths", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^chg_[a-f0-9]{32}$"},
        "resourceRef": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"},
        "kind": {"type": "string", "enum": ["created", "configuration", "image", "scale", "relationships", "status", "deleted"]},
        "observedAt": {"type": "string", "format": "date-time"},
        "recordedAt": {"type": "string", "format": "date-time"},
        "beforeObservationHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "afterObservationHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "changedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)*(?:/(?:[^~/]|~0|~1)*)*$", "maxLength": 512}
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "streamId", "sequence"],
          "properties": {
            "sourceId": {"type": "string", "minLength": 1, "maxLength": 256},
            "streamId": {"type": "string", "pattern": "^obs_[a-f0-9]{32}$"},
            "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
            "resourceVersion": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    }
  }
}
