{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:session-context:v1alpha1",
  "title": "Infrastructure Intelligence Session Context",
  "description": "The non-secret tenant, actor, and role context derived from an authenticated control-plane credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "SessionContext"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "actorId"],
      "properties": {
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roles"],
      "properties": {
        "roles": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{0,63}$"
          }
        }
      }
    }
  }
}
