{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:ai-usage-attribution-record:v1alpha1",
  "title": "AI Usage Attribution Record",
  "description": "An immutable, source-bound application and team resolution for one AI usage record under one protected policy generation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "AiUsageAttributionRecord"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "resolvedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^aia_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "resolvedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageRecordId", "effectiveAt", "engineVersion", "policy", "observedIdentity", "resolution"],
      "properties": {
        "usageRecordId": {"type": "string", "pattern": "^aiu_[a-f0-9]{32}$"},
        "effectiveAt": {"type": "string", "format": "date-time"},
        "engineVersion": {"type": "string", "pattern": "^[0-9]+[.][0-9]+[.][0-9]+$"},
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version", "sourceHash"],
          "properties": {
            "id": {"type": "string", "pattern": "^aap_[a-f0-9]{32}$"},
            "version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
            "sourceHash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
          }
        },
        "observedIdentity": {"$ref": "#/$defs/observedIdentity"},
        "resolution": {
          "oneOf": [
            {"$ref": "#/$defs/allocated"},
            {"$ref": "#/$defs/unallocated"}
          ]
        }
      }
    }
  },
  "$defs": {
    "safeId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
    "safeText": {"type": "string", "minLength": 1, "maxLength": 256},
    "organizationalUnit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"$ref": "#/$defs/safeId"},
        "name": {"$ref": "#/$defs/safeText"}
      }
    },
    "observedIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceName", "resourceRefs"],
      "properties": {
        "serviceName": {"$ref": "#/$defs/safeText"},
        "serviceNamespace": {"$ref": "#/$defs/safeText"},
        "deploymentEnvironment": {"type": "string", "minLength": 1, "maxLength": 128},
        "resourceRefs": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        }
      }
    },
    "allocated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "ruleId", "application", "team"],
      "properties": {
        "status": {"const": "allocated"},
        "ruleId": {"$ref": "#/$defs/safeId"},
        "application": {"$ref": "#/$defs/organizationalUnit"},
        "team": {"$ref": "#/$defs/organizationalUnit"}
      }
    },
    "unallocated": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCode"],
      "properties": {
        "status": {"const": "unallocated"},
        "reasonCode": {"const": "no-matching-rule"}
      }
    }
  }
}
