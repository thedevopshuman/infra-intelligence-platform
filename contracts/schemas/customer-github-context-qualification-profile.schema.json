{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-github-context-qualification-profile:v1alpha1",
  "title": "Customer GitHub Context Qualification Profile",
  "description": "Protected exact document selection for qualifying one customer GitHub or GitHub Enterprise context read.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerGithubContextQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceMode", "query", "expected", "objective"],
      "properties": {
        "serviceMode": {"enum": ["github-cloud", "github-enterprise-server"]},
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "actorId", "integrationId", "resourceUid", "referenceId", "documentKind"],
          "properties": {
            "tenantId": {"$ref": "#/$defs/tenantId"},
            "actorId": {"$ref": "#/$defs/actorId"},
            "integrationId": {"$ref": "#/$defs/integrationId"},
            "resourceUid": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"},
            "referenceId": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"},
            "documentKind": {"enum": ["runbook", "source", "configuration", "service-catalog"]}
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["endpoint", "apiVersion", "credentialRef", "repositoryOwner", "repositoryName", "commitSha", "path", "blobSha"],
          "properties": {
            "endpoint": {"type": "string", "pattern": "^https://", "maxLength": 2048},
            "apiVersion": {"type": "string", "pattern": "^20[0-9]{2}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])$"},
            "credentialRef": {"type": "string", "pattern": "^credential://[A-Za-z0-9._~:/-]{1,2020}$", "maxLength": 2048},
            "repositoryOwner": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$", "maxLength": 39},
            "repositoryName": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
            "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            "path": {"type": "string", "minLength": 1, "maxLength": 1024},
            "blobSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestTimeoutSeconds", "maximumResponseBytes", "maximumDocumentBytes", "requestDeadlineSeconds", "maximumReadLatencyMilliseconds", "maximumProfileAgeSeconds"],
          "properties": {
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "maximumResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 2097152},
            "maximumDocumentBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
            "requestDeadlineSeconds": {"type": "integer", "minimum": 5, "maximum": 300},
            "maximumReadLatencyMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000}
          }
        }
      }
    }
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "actorId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$", "not": {"const": "anonymous"}},
    "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
  }
}
