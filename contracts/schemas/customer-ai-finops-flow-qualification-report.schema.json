{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-ai-finops-flow-qualification-report:v1alpha1",
  "title": "Customer AI FinOps Flow Qualification Report",
  "description": "Privacy-minimized same-invocation evidence for one Bedrock-to-IIP-to-Prometheus/Grafana customer flow.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerAiFinopsFlowQualificationReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "validUntil", "sourceRevision", "sourceDirty"],
      "properties": {
        "id": {"type": "string", "pattern": "^caff_[a-f0-9]{32}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "validUntil": {"type": "string", "format": "date-time"},
        "sourceRevision": {"$ref": "#/$defs/revision"},
        "sourceDirty": {"const": false}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "qualificationLevel", "qualificationBoundary", "subject", "bindings", "profile", "measurements", "results", "checks", "limitations", "summary"],
      "properties": {
        "status": {"enum": ["qualified", "not-qualified"]},
        "qualificationLevel": {"const": "customer-ai-finops-flow-v1"},
        "qualificationBoundary": {"const": "same-invocation-customer-runtime"},
        "subject": {"$ref": "#/$defs/subject"},
        "bindings": {"$ref": "#/$defs/bindings"},
        "profile": {"$ref": "#/$defs/profile"},
        "measurements": {"$ref": "#/$defs/measurements"},
        "results": {"$ref": "#/$defs/results"},
        "checks": {"$ref": "#/$defs/checks"},
        "limitations": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {"const": "dashboard-proof-is-protected-dimension-aggregate-not-trace-labelled"},
            {"const": "invoice-private-rates-discounts-and-commitments-not-qualified"},
            {"const": "customer-long-running-collector-and-backend-lifecycle-not-qualified"},
            {"const": "sustained-load-node-zone-region-and-backend-ha-not-qualified"},
            {"const": "additional-models-regions-operations-providers-and-backends-not-qualified"}
          ],
          "items": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalChecks", "passedChecks", "failedChecks", "overallStatus"],
          "properties": {
            "totalChecks": {"const": 15},
            "passedChecks": {"type": "integer", "minimum": 0, "maximum": 15},
            "failedChecks": {"type": "integer", "minimum": 0, "maximum": 15},
            "overallStatus": {"enum": ["qualified", "not-qualified"]}
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploymentProfile", "applicationVersion", "chartVersion", "contractsApiVersion", "sourceRevision", "imageDigest"],
      "properties": {
        "deploymentProfile": {"enum": ["production-ai-finops-v0", "production-ai-finops-v1"]},
        "applicationVersion": {"$ref": "#/$defs/semver"},
        "chartVersion": {"$ref": "#/$defs/semver"},
        "contractsApiVersion": {"const": "iip.platform/v1alpha1"},
        "sourceRevision": {"$ref": "#/$defs/revision"},
        "imageDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileDigest", "environmentBindingDigest", "prerequisiteProfileDigest", "prerequisiteReportDigest", "bedrockProfileDigest", "controlPlaneTargetDigest", "otlpTargetDigest", "prometheusTargetDigest", "grafanaTargetDigest", "runEvidenceDigest", "liveCompatibilityReportDigest", "invocationObservationDigest", "correlationDigest", "usageRecordDigest", "attributionRecordDigest", "activeAttributionPolicyDocumentDigest", "costRecordDigest", "activePriceCatalogDocumentDigest"],
      "properties": {
        "profileDigest": {"$ref": "#/$defs/digest"},
        "environmentBindingDigest": {"$ref": "#/$defs/digest"},
        "prerequisiteProfileDigest": {"$ref": "#/$defs/digest"},
        "prerequisiteReportDigest": {"$ref": "#/$defs/digest"},
        "bedrockProfileDigest": {"$ref": "#/$defs/digest"},
        "controlPlaneTargetDigest": {"$ref": "#/$defs/digest"},
        "otlpTargetDigest": {"$ref": "#/$defs/digest"},
        "prometheusTargetDigest": {"$ref": "#/$defs/digest"},
        "grafanaTargetDigest": {"$ref": "#/$defs/digest"},
        "runEvidenceDigest": {"$ref": "#/$defs/digest"},
        "liveCompatibilityReportDigest": {"$ref": "#/$defs/digest"},
        "invocationObservationDigest": {"$ref": "#/$defs/digest"},
        "correlationDigest": {"$ref": "#/$defs/digest"},
        "usageRecordDigest": {"$ref": "#/$defs/digest"},
        "attributionRecordDigest": {"$ref": "#/$defs/digest"},
        "activeAttributionPolicyDocumentDigest": {"$ref": "#/$defs/digest"},
        "costRecordDigest": {"$ref": "#/$defs/digest"},
        "activePriceCatalogDocumentDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "operation", "requestPath", "telemetryPath", "contentPolicy", "costBasis", "telemetryBackend", "dashboard", "correlationMode"],
      "properties": {
        "provider": {"const": "aws.bedrock"},
        "operation": {"const": "ConverseStream"},
        "requestPath": {"const": "direct-to-provider"},
        "telemetryPath": {"const": "asynchronous-otel"},
        "contentPolicy": {"const": "metadata-only"},
        "costBasis": {"const": "calculated-estimate"},
        "telemetryBackend": {"const": "prometheus"},
        "dashboard": {"const": "grafana"},
        "correlationMode": {"const": "protected-request-digest-response"}
      }
    },
    "measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileReviewedAt", "startedAt", "completedAt", "endToEndLatencyMilliseconds", "observationPolls", "providerCallCount", "usageRecordCount", "attributionRecordCount", "costRecordCount", "prometheusRequestDelta", "dashboardPanelCount"],
      "properties": {
        "profileReviewedAt": {"type": "string", "format": "date-time"},
        "startedAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "endToEndLatencyMilliseconds": {"type": "integer", "minimum": 0, "maximum": 900000},
        "observationPolls": {"type": "integer", "minimum": 1, "maximum": 3600},
        "providerCallCount": {"const": 1},
        "usageRecordCount": {"const": 1},
        "attributionRecordCount": {"const": 1},
        "costRecordCount": {"const": 1},
        "prometheusRequestDelta": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "dashboardPanelCount": {"type": "integer", "minimum": 5, "maximum": 1000}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerCall", "otlpDelivery", "usage", "attribution", "cost", "telemetryAggregate", "dashboard"],
      "properties": {
        "providerCall": {"const": "completed"},
        "otlpDelivery": {"const": "correlated"},
        "usage": {"const": "recorded"},
        "attribution": {"const": "allocated"},
        "cost": {"const": "priced-calculated-estimate"},
        "telemetryAggregate": {"const": "observed"},
        "dashboard": {"const": "provisioned"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "status": {"enum": ["passed", "failed"]},
        "errorCode": {"type": "string", "pattern": "^customer-ai-finops-flow[.][a-z0-9.-]+$", "maxLength": 160}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "failed"}}}
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "prefixItems": [
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "source-binding"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "profile-review"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "prerequisite-binding"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "bedrock-profile-binding"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "protected-inputs"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "metadata-only-direct-request-path"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "live-provider-call"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "otlp-delivery-correlation"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "exact-usage-record"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "active-attribution"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "active-pricing"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "bounded-processing-latency"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "prometheus-aggregate-delta"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "grafana-dashboard"}}},
        {"$ref": "#/$defs/check", "properties": {"id": {"const": "minimized-output"}}}
      ],
      "items": false
    }
  }
}
