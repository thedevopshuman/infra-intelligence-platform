{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-ai-finops-prerequisite-profile:v1alpha1",
  "title": "Customer AI FinOps Prerequisite Profile",
  "description": "Protected reviewed selection that binds the exact release, customer environment, production price catalog, and reference dashboard boundary for AI FinOps prerequisite aggregation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerAiFinopsPrerequisiteProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "environmentId", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "environmentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "collection", "pricing", "presentation", "objective"],
      "properties": {
        "release": {
          "type": "object",
          "additionalProperties": false,
          "required": ["applicationVersion", "chartVersion", "sourceRevision", "imageDigest"],
          "properties": {
            "applicationVersion": {"$ref": "#/$defs/semver"},
            "chartVersion": {"$ref": "#/$defs/semver"},
            "sourceRevision": {"$ref": "#/$defs/revision"},
            "imageDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "operation", "requestPath", "telemetryPath", "contentPolicy"],
          "properties": {
            "provider": {"const": "aws.bedrock"},
            "operation": {"const": "ConverseStream"},
            "requestPath": {"const": "direct-to-provider"},
            "telemetryPath": {"const": "asynchronous-otel"},
            "contentPolicy": {"const": "metadata-only"}
          }
        },
        "pricing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "catalogId", "catalogVersion", "catalogDocumentDigest", "qualificationPolicyId", "qualificationPolicyVersion", "sourceClass", "costBasis"],
          "properties": {
            "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
            "catalogId": {"type": "string", "pattern": "^apc_[a-f0-9]{32}$"},
            "catalogVersion": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
            "catalogDocumentDigest": {"$ref": "#/$defs/digest"},
            "qualificationPolicyId": {"type": "string", "pattern": "^apqp_[a-f0-9]{32}$"},
            "qualificationPolicyVersion": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}[.][0-9]+$"},
            "sourceClass": {"enum": ["provider-published", "operator-managed"]},
            "costBasis": {"const": "calculated-estimate"}
          }
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["telemetryBackend", "dashboard"],
          "properties": {
            "telemetryBackend": {"const": "prometheus"},
            "dashboard": {"const": "grafana"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumProfileAgeSeconds", "maximumEvidenceAgeSeconds", "maximumClockSkewSeconds", "reportValiditySeconds"],
          "properties": {
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000},
            "maximumEvidenceAgeSeconds": {"type": "integer", "minimum": 300, "maximum": 604800},
            "maximumClockSkewSeconds": {"type": "integer", "minimum": 0, "maximum": 900},
            "reportValiditySeconds": {"type": "integer", "minimum": 300, "maximum": 604800}
          }
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
  }
}
