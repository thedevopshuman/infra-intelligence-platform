        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "iip_ai_context_growth_change{job=\"iip-ai-economics\"} / 100",
          "instant": true,
          "legendFormat": "input tokens/request",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "What changed?",
      "type": "gauge"
    },
    {
