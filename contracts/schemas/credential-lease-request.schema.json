{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:credential-lease-request:v1alpha1",
  "title": "Credential Lease Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.broker/v1alpha1"},
    "kind": {"const": "CredentialLeaseRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^crq_[a-f0-9]{32}$"},
        "tenantId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9._-]{1,128}$"
        },
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrationId",
        "credentialRef",
        "provider",
        "scopes",
        "deadline"
      ],
      "properties": {
        "integrationId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "credentialRef": {
          "type": "string",
          "pattern": "^credential://[A-Za-z0-9._~:/-]{1,2020}$"
        },
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{1,63}$"
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._/-]{0,63}(?::[a-z][a-z0-9._/-]{0,63}){1,2}$",
            "maxLength": 194
          }
        },
        "deadline": {"type": "string", "format": "date-time"}
      }
    }
  }
}
