{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:investigation-signal-catalog:v1alpha1",
  "title": "Infrastructure Intelligence Investigation Signal Catalog",
  "description": "Protected tenant-bound investigation candidate profiles without transport or credential authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "profiles"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "InvestigationSignalCatalog"},
    "profiles": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/profile"}
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "profileId", "version", "selections"],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "profileId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "selections": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "kubernetesEventSelections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "urn:iip:contracts:investigation-request:v1alpha1#/$defs/kubernetesEventSelection"
              }
            },
            "contextSelections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "urn:iip:contracts:investigation-request:v1alpha1#/$defs/contextSelection"
              }
            },
            "changeSelections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "urn:iip:contracts:investigation-request:v1alpha1#/$defs/changeSelection"
              }
            },
            "telemetrySelections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"$ref": "#/$defs/telemetrySelection"}
            },
            "logSelections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "$ref": "urn:iip:contracts:investigation-request:v1alpha1#/$defs/logSelection"
              }
            }
          }
        }
      }
    },
    "telemetrySelection": {
      "allOf": [
        {
          "$ref": "urn:iip:contracts:investigation-request:v1alpha1#/$defs/telemetrySelection"
        },
        {
          "not": {
            "anyOf": [
              {"required": ["baselineComparison"]},
              {"required": ["rollingBaselineComparison"]}
            ]
          }
        }
      ]
    }
  }
}
