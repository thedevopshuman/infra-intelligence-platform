{
  "openapi": "3.1.0",
  "info": {
    "title": "Infrastructure Intelligence Control Plane API",
    "version": "0.28.0",
    "description": "Executable control-plane API for authenticated session and runtime identity, collection ingestion, freshness telemetry, backend-neutral evidence, resource queries, synchronous or durably queued investigation assessment, governed actions, and bounded plugin sessions. OTLP intake has a separate process and OpenAPI document."
  },
  "servers": [{"url": "http://localhost:8080"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "health",
        "security": [],
        "responses": {"200": {"description": "Process is healthy"}}
      }
    },
    "/readyz": {
      "get": {
        "operationId": "ready",
        "security": [],
        "responses": {
          "200": {"description": "Process and required durable dependencies are ready"},
          "503": {"description": "A required dependency or schema migration is unavailable"}
        }
      }
    },
    "/v1/session": {
      "get": {
        "operationId": "getSession",
        "description": "Return the non-secret tenant, actor, and role context derived from the authenticated control-plane credential.",
        "responses": {
          "200": {"description": "Authenticated session context", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/session-context.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/v1/system/version": {
      "get": {
        "operationId": "getRuntimeVersion",
        "description": "Return tenant-contextual, non-secret application, contract, required storage migration, build, and deployment identity for the answering process. Optional revision, chart, and digest fields are omitted when not verifiably supplied.",
        "responses": {
          "200": {"description": "Authenticated runtime version identity", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/runtime-version-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/v1/resources": {
      "get": {
        "operationId": "listResources",
        "responses": {
          "200": {
            "description": "Tenant-scoped resources",
            "content": {"application/json": {"schema": {"type": "object", "required": ["items"], "properties": {"items": {"type": "array", "items": {"$ref": "../../contracts/schemas/resource.schema.json"}}}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      },
      "post": {
        "operationId": "ingestResource",
        "parameters": [
          {"$ref": "#/components/parameters/CorrelationId"}
        ],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource.schema.json"}}}
        },
        "responses": {
          "202": {"description": "Observation accepted", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/resources/{resourceUid}/neighborhood": {
      "get": {
        "operationId": "getResourceNeighborhood",
        "parameters": [
          {"$ref": "#/components/parameters/ResourceUid"},
          {"name": "depth", "in": "query", "schema": {"type": "integer", "const": 1}, "description": "The v1alpha1 query supports exactly one hop."},
          {"name": "direction", "in": "query", "schema": {"type": "string", "enum": ["incoming", "outgoing", "both"], "default": "both"}},
          {"name": "relationshipType", "in": "query", "style": "form", "explode": true, "schema": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$"}}},
          {"$ref": "#/components/parameters/PageLimit"},
          {"$ref": "#/components/parameters/PageCursor"}
        ],
        "responses": {
          "200": {"description": "Current tenant-scoped depth-one resource neighborhood", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource-neighborhood.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/resources/{resourceUid}/timeline": {
      "get": {
        "operationId": "getResourceTimeline",
        "parameters": [
          {"$ref": "#/components/parameters/ResourceUid"},
          {"$ref": "#/components/parameters/PageLimit"},
          {"$ref": "#/components/parameters/PageCursor"}
        ],
        "responses": {
          "200": {"description": "Ascending tenant-scoped immutable resource observations", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource-timeline.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/telemetry/ingestion": {
      "get": {
        "operationId": "getIngestionFreshness",
        "parameters": [
          {
            "name": "sourceId",
            "in": "query",
            "required": true,
            "schema": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"}
          }
        ],
        "responses": {
          "200": {"description": "Point-in-time tenant/source ingestion freshness and delivery-objective evaluation", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/ingestion-freshness-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "404": {
            "description": "No committed source checkpoint exists in the authenticated tenant",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "ingestion.source_not_found"}}}}
          },
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/operations/telemetry/export-health": {
      "get": {
        "operationId": "getTelemetryExportHealth",
        "description": "Return process-local metric and trace export outcomes to an authenticated platform administrator. The report contains no endpoint, credential, tenant telemetry, payload, provider response, or exception text and does not affect readiness.",
        "responses": {
          "200": {"description": "Bounded process-local telemetry delivery state", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/telemetry-export-health-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "503": {
            "description": "The process-local exporter health reader returned inconsistent state",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "telemetry.export-health.unavailable"}}}}
          }
        }
      }
    },
    "/v1/collections/ingest": {
      "post": {
        "operationId": "ingestResourceCollection",
        "parameters": [{"$ref": "#/components/parameters/CorrelationId"}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "additionalProperties": false,
            "required": ["request", "result"],
            "properties": {
              "request": {"$ref": "../../contracts/schemas/resource-collection-request.schema.json"},
              "result": {"$ref": "../../contracts/schemas/resource-collection-result.schema.json"}
            }
          }}}
        },
        "responses": {
          "202": {
            "description": "Validated observations and any complete-snapshot tombstones are durable; reconciliation membership, aggregate checkpoint, and opaque provider cursor state are committed",
            "content": {"application/json": {"schema": {
              "type": "object",
              "additionalProperties": false,
              "required": ["items"],
              "properties": {"items": {"type": "array", "items": {"$ref": "../../contracts/schemas/resource.schema.json"}}}
            }}}
          },
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/evidence/telemetry/queries": {
      "post": {
        "operationId": "collectTelemetryEvidence",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/telemetry-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized metric result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Telemetry request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "telemetry.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The telemetry provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/logs/queries": {
      "post": {
        "operationId": "collectLogEvidence",
        "description": "Collect bounded normalized log evidence for authenticated tenant-scoped resources. The request uses logical services, severities, and attribute filters; provider endpoints, credentials, and vendor query languages remain protected adapter configuration.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/log-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized log result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Log evidence request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "logs.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The log provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/kubernetes/events/queries": {
      "post": {
        "operationId": "collectKubernetesEventEvidence",
        "description": "Collect bounded normalized Kubernetes Event evidence for authenticated tenant-scoped resources. Provider endpoint, TLS, namespace/type allowlists, and credentials are protected integration configuration and never request fields; the default backend returns honest no-data unless the read-only Kubernetes API adapter is selected.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/kubernetes-event-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing the normalized Kubernetes Event result artifact", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Kubernetes Event request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "kubernetes.event.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The Kubernetes Event provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/changes/queries": {
      "post": {
        "operationId": "collectResourceChangeEvidence",
        "description": "Collect bounded value-minimized changes from accepted immutable observations for authenticated tenant-scoped resources.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/resource-change-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing normalized resource-change history", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Resource change request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "change.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The history provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/context/queries": {
      "post": {
        "operationId": "collectContextEvidence",
        "description": "Collect bounded redacted excerpts from tenant-scoped repository and runbook files explicitly allowlisted in protected integration configuration. Returned text is always marked untrusted data and never grants instructions or authority.",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/context-evidence-request.schema.json"}}}
        },
        "responses": {
          "201": {"description": "Immutable Evidence envelope referencing normalized repository/runbook context", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "400": {
            "description": "Context evidence request validation failed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "context.request.invalid"}}}}
          },
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "408": {
            "description": "The bounded evidence deadline elapsed",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "example": {"error": {"code": "evidence.deadline.exceeded"}}}}
          },
          "503": {
            "description": "The context provider, evidence processor, or store is unavailable",
            "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}, "examples": {"provider": {"value": {"error": {"code": "evidence.provider.unavailable"}}}, "storage": {"value": {"error": {"code": "storage.unavailable"}}}}}}
          }
        }
      }
    },
    "/v1/evidence/{evidenceId}": {
      "get": {
        "operationId": "getEvidence",
        "parameters": [{"name": "evidenceId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^evd_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped evidence metadata", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/evidence.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations": {
      "post": {
        "operationId": "runInvestigation",
        "description": "Run a bounded investigation. Optional Kubernetes Event, repository/runbook context, resource-change, metric, and historical log selections inherit authenticated identity, resource/time scope, and investigation tool/evidence budgets before using configured backend-neutral adapters. Empty signal lists may be filled from a protected tenant profile and frozen with server-owned digest provenance; clients must not supply catalogSnapshot. Root-cause-scoped selections assess only committed normalized artifacts and record supporting, contradicting, neutral, no-data, or incomplete results. Context and log prose is untrusted data, is never interpreted as instructions, and is not copied into reports.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-request.schema.json"}}}},
        "responses": {
          "201": {"description": "Immutable terminal investigation report", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-report.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigation-jobs": {
      "post": {
        "operationId": "submitInvestigation",
        "description": "Validate and durably queue one immutable investigation request. Protected tenant catalog candidates are resolved and content-digested before persistence, then a tenant-scoped worker verifies the frozen snapshot and claims it under a renewable dispatch lease. Investigation upper bounds, budgets, and the separate non-renewable execution deadline remain authoritative.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-request.schema.json"}}}},
        "responses": {
          "202": {"description": "Request durably queued or its existing idempotent job returned", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-job-status.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigation-jobs/{investigationId}": {
      "get": {
        "operationId": "getInvestigationJob",
        "description": "Return bounded dispatch state from the authenticated tenant. Worker identity, claim tokens, request content, evidence, and provider details are never exposed.",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped background investigation status", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-job-status.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigation-jobs/{investigationId}/cancel": {
      "post": {
        "operationId": "cancelInvestigationJob",
        "description": "Cancel queued work without execution, or durably propagate cooperative cancellation to a claimed investigation. The first cancellation intent remains immutable.",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-cancellation-request.schema.json"}}}},
        "responses": {
          "202": {"description": "Cancellation intent or existing terminal state", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-job-status.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations/{investigationId}": {
      "get": {
        "operationId": "getInvestigation",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Tenant-scoped terminal report", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-report.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations/{investigationId}/status": {
      "get": {
        "operationId": "getInvestigationStatus",
        "description": "Return the current tenant-scoped lifecycle state. Running state is persisted before tools execute; terminal status points to the immutable report.",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "responses": {
          "200": {"description": "Durable investigation lifecycle status", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-status.schema.json"}}}},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/investigations/{investigationId}/cancel": {
      "post": {
        "operationId": "cancelInvestigation",
        "description": "Atomically record the first authenticated cooperative cancellation request. Already committed evidence is retained; no lifecycle or audit data is deleted.",
        "parameters": [{"name": "investigationId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-cancellation-request.schema.json"}}}},
        "responses": {
          "202": {"description": "Cancellation recorded or current terminal status returned", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/investigation-status.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "404": {"$ref": "#/components/responses/ResourceNotFound"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions": {
      "get": {
        "operationId": "listActionWorkflows",
        "description": "List newest governed action workflows from one tenant-consistent read model. Each item reconstructs its immutable proposal and any approval, one-shot execution lifecycle, and terminal result.",
        "parameters": [
          {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}},
          {"name": "cursor", "in": "query", "schema": {"type": "string", "pattern": "^p1\\.[A-Za-z0-9_-]+$", "maxLength": 2048}}
        ],
        "responses": {
          "200": {"description": "Tenant-scoped action workflow page", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/action-workflow-page.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
        }
      }
    },
    "/v1/actions/proposals": {
      "post": {
        "operationId": "proposeAction",
        "description": "Create an immutable proposal bound to a completed investigation, the exact target resource digest, its accepted observation integration, and the observed provider object UID when available.",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["investigationId", "actionType", "targetResourceUid", "parameters", "idempotencyKey", "expiresAt"], "properties": {"investigationId": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"}, "actionType": {"const": "kubernetes.restart-workload"}, "targetResourceUid": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}, "parameters": {"type": "object", "additionalProperties": false, "required": ["namespace", "workloadKind", "workloadName"], "properties": {"namespace": {"type": "string", "maxLength": 253}, "workloadKind": {"type": "string", "enum": ["deployment", "statefulset", "daemonset"]}, "workloadName": {"type": "string", "maxLength": 253}}}, "idempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"}, "expiresAt": {"type": "string", "format": "date-time"}, "dryRun": {"type": "boolean", "default": true}}}}}},
        "responses": {
          "201": {"description": "Immutable action proposal", "content": {"application/json": {"schema": {"$ref": "../../contracts/schemas/action-proposal.schema.json"}}}},
          "400": {"$ref": "#/components/responses/InvalidRequest"},
          "401": {"$ref": "#/components/responses/Unauthorized"},
          "403": {"$ref": "#/components/responses/PolicyDenied"},
          "409": {"$ref": "#/components/responses/ObservationConflict"},
          "503": {"$ref": "#/components/responses/StorageUnavailable"}
