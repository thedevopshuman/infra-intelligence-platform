{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:context-evidence-request:v1alpha1",
  "title": "Infrastructure Intelligence Context Evidence Request",
  "description": "A bounded tenant-scoped request for allowlisted repository and runbook context.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ContextEvidenceRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^ctq_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,128}$"},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrationId", "resourceRefs", "query", "limits", "deadline"],
      "properties": {
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "query": {"$ref": "#/$defs/query"},
        "limits": {"$ref": "#/$defs/limits"},
        "deadline": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "referenceIds"],
      "properties": {
        "kinds": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["runbook", "source", "configuration", "service-catalog"]
          }
        },
        "referenceIds": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9._/-]{2,127}$"}
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDocuments", "maxExcerptChars", "maxBytes"],
      "properties": {
        "maxDocuments": {"type": "integer", "minimum": 1, "maximum": 32},
        "maxExcerptChars": {"type": "integer", "minimum": 1, "maximum": 8192},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    }
  }
}
