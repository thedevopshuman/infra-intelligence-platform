{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:investigation-completion-slo-report:v1alpha1",
  "title": "Infrastructure Intelligence Investigation Completion SLO Report",
  "description": "Tenant-scoped rolling useful-completion objective calculated from durable asynchronous investigation jobs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "InvestigationCompletionSloReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "evaluatedAt"],
      "properties": {
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "window", "objective", "measurement"],
      "properties": {
        "status": {"type": "string", "enum": ["no-data", "insufficient-data", "meeting", "breached"]},
        "window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSeconds", "start", "end", "maturityCutoff"],
          "properties": {
            "durationSeconds": {"type": "integer", "minimum": 300, "maximum": 2592000},
            "start": {"type": "string", "format": "date-time"},
            "end": {"type": "string", "format": "date-time"},
            "maturityCutoff": {"type": "string", "format": "date-time"}
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumCompletionSeconds", "minimumAttainmentBasisPoints", "minimumEligibleJobs"],
          "properties": {
            "maximumCompletionSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
            "minimumAttainmentBasisPoints": {"type": "integer", "minimum": 1, "maximum": 10000},
            "minimumEligibleJobs": {"type": "integer", "minimum": 1, "maximum": 1000000}
          }
        },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["acceptedJobs", "immatureJobs", "eligibleJobs", "withinObjectiveJobs", "lateCompletedJobs", "failedJobs", "cancelledJobs", "unfinishedJobs", "attainmentBasisPoints"],
          "properties": {
            "acceptedJobs": {"$ref": "#/$defs/counter"},
            "immatureJobs": {"$ref": "#/$defs/counter"},
            "eligibleJobs": {"$ref": "#/$defs/counter"},
            "withinObjectiveJobs": {"$ref": "#/$defs/counter"},
            "lateCompletedJobs": {"$ref": "#/$defs/counter"},
            "failedJobs": {"$ref": "#/$defs/counter"},
            "cancelledJobs": {"$ref": "#/$defs/counter"},
            "unfinishedJobs": {"$ref": "#/$defs/counter"},
            "attainmentBasisPoints": {
              "oneOf": [
                {"type": "integer", "minimum": 0, "maximum": 10000},
                {"type": "null"}
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "no-data"}}},
          "then": {
            "properties": {
              "measurement": {
                "properties": {
                  "eligibleJobs": {"const": 0},
                  "withinObjectiveJobs": {"const": 0},
                  "lateCompletedJobs": {"const": 0},
                  "failedJobs": {"const": 0},
                  "cancelledJobs": {"const": 0},
                  "unfinishedJobs": {"const": 0},
                  "attainmentBasisPoints": {"type": "null"}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"enum": ["insufficient-data", "meeting", "breached"]}}},
          "then": {
            "properties": {
              "measurement": {
                "properties": {
                  "eligibleJobs": {"minimum": 1},
                  "attainmentBasisPoints": {"type": "integer"}
                }
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "counter": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
  }
}
