{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:action-result:v1alpha1",
  "title": "Infrastructure Intelligence Action Result",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ActionResult"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tenantId", "completedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^act_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "completedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["proposalDigest", "approvalId", "outcome", "idempotencyKey", "execution", "verification", "auditRef"],
      "properties": {
        "proposalDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "approvalId": {"type": "string", "pattern": "^apr_[a-f0-9]{32}$"},
        "outcome": {"type": "string", "enum": ["dry-run", "succeeded", "failed", "rolled-back"]},
        "idempotencyKey": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
        "execution": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "operationRef"],
          "properties": {
            "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"},
            "operationRef": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048}
          }
        },
        "verification": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "summary"],
          "properties": {
            "status": {"type": "string", "enum": ["not-run", "passed", "failed"]},
            "summary": {"type": "string", "minLength": 1, "maxLength": 4096}
          }
        },
        "auditRef": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "executionStatusRef": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "executionPolicyInputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
