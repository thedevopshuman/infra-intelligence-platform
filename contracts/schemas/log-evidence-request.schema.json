{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:log-evidence-request:v1alpha1",
  "title": "Infrastructure Intelligence Log Evidence Request",
  "description": "A tenant- and actor-scoped bounded request for normalized log evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "LogEvidenceRequest"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "tenantId", "actorId", "requestedAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^leq_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9._-]{1,128}$"},
        "actorId": {"type": "string", "minLength": 1, "maxLength": 256},
        "requestedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integrationId",
        "resourceRefs",
        "signal",
        "timeRange",
        "query",
        "limits",
        "deadline"
      ],
      "properties": {
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "resourceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"}
        },
        "signal": {"const": "logs"},
        "timeRange": {"$ref": "#/$defs/timeRange"},
        "query": {"$ref": "#/$defs/query"},
        "limits": {"$ref": "#/$defs/limits"},
        "deadline": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceNames", "severities", "filters"],
      "properties": {
        "serviceNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$"}
        },
        "severities": {
          "type": "array",
          "maxItems": 7,
          "uniqueItems": true,
          "items": {"enum": ["trace", "debug", "info", "warn", "error", "fatal", "unspecified"]}
        },
        "filters": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "#/$defs/filter"}
        }
      }
    },
    "filter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "operator", "value"],
      "properties": {
        "attribute": {"$ref": "#/$defs/attributeName"},
        "operator": {"enum": ["eq", "neq"]},
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1F\\x7F]+$"
        }
      }
    },
    "attributeName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,127}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxRecords", "maxBytes"],
      "properties": {
        "maxRecords": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxBytes": {"type": "integer", "minimum": 1, "maximum": 16777216}
      }
    }
  }
}
