  "description": "Single-tenant community view over the last successful rolling 24-hour ledger allocation projection. Usage, cost, and coverage update independently of savings evaluation; this runtime does not export projection-age telemetry, so backend freshness alone does not prove a new projection succeeded. Change and potential-saving panels use optional completed fixed-window evaluations and may have no data. Currency: __IIP_CURRENCY__; scale: __IIP_CURRENCY_SCALE__.",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iip-prometheus"
      },
      "description": "Observed invocations in the worker's rolling 24-hour allocation projection. The application dimension is selected so application and team projections are not counted twice.",
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No projection data",
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(iip_ai_allocation_requests{iip_ai_allocation_dimension=\"application\",job=\"iip-ai-economics\"})",
          "instant": true,
          "legendFormat": "observed requests",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Observed requests — rolling 24h",
      "type": "stat"
    },
