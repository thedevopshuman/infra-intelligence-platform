{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:credential-broker-compatibility-report:v1alpha1",
  "title": "Credential Broker Compatibility Report",
  "description": "Source-bound TLS, workload-identity, authority, rotation, audit, and recovery evidence for the external credential-broker client.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CredentialBrokerCompatibilityReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generatedAt", "sourceRevision", "sourceDirty"],
      "properties": {
        "id": {"type": "string", "pattern": "^cbr_[a-f0-9]{32}$"},
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceRevision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "sourceDirty": {"type": "boolean"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "environment", "profile", "checks", "summary"],
      "properties": {
        "status": {"enum": ["compatible", "incompatible"]},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "containerRuntime", "containerRuntimeVersion", "pythonVersion", "applicationVersion"],
          "properties": {
            "platform": {"type": "string", "pattern": "^[a-z0-9_.-]+/[a-zA-Z0-9_.-]+$"},
            "containerRuntime": {"const": "docker"},
            "containerRuntimeVersion": {"type": "string", "minLength": 1, "maxLength": 64},
            "pythonVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
            "applicationVersion": {"$ref": "#/$defs/semver"}
          }
        },
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "brokerProtocol", "workloadTokenProfile", "leaseScheme", "maxLeaseSeconds"],
          "properties": {
            "name": {"const": "local-tls-workload-identity-v1"},
            "brokerProtocol": {"const": "iip.broker/v1alpha1"},
            "workloadTokenProfile": {"const": "signed-jwt-fixture"},
            "leaseScheme": {"const": "bearer"},
            "maxLeaseSeconds": {"const": 120}
          }
        },
        "checks": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "prefixItems": [
            {"$ref": "#/$defs/caVerifiedTlsCheck"},
            {"$ref": "#/$defs/untrustedCaDenialCheck"},
            {"$ref": "#/$defs/workloadJwtAuthenticationCheck"},
            {"$ref": "#/$defs/audienceDenialCheck"},
            {"$ref": "#/$defs/subjectDenialCheck"},
            {"$ref": "#/$defs/exactScopeLeaseCheck"},
            {"$ref": "#/$defs/crossTenantDenialCheck"},
            {"$ref": "#/$defs/scopeEscalationDenialCheck"},
            {"$ref": "#/$defs/rotationWithoutRestartCheck"},
            {"$ref": "#/$defs/revocationCheck"},
            {"$ref": "#/$defs/auditCompletenessCheck"},
            {"$ref": "#/$defs/brokerOutageFailClosedCheck"},
            {"$ref": "#/$defs/brokerRecoveryCheck"},
            {"$ref": "#/$defs/secretRedactionCheck"}
          ],
          "items": false
        },
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["totalChecks", "passedChecks", "failedChecks", "overallStatus"],
          "properties": {
            "totalChecks": {"const": 14},
            "passedChecks": {"type": "integer", "minimum": 0, "maximum": 14},
            "failedChecks": {"type": "integer", "minimum": 0, "maximum": 14},
            "overallStatus": {"enum": ["compatible", "incompatible"]}
          }
        }
      }
    }
  },
  "$defs": {
    "semver": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["passed", "failed"]},
        "errorCode": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$", "maxLength": 128}
      },
      "oneOf": [
        {"properties": {"status": {"const": "passed"}}, "not": {"required": ["errorCode"]}},
        {"required": ["errorCode"], "properties": {"status": {"const": "failed"}}}
      ]
    },
    "caVerifiedTlsCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "ca-verified-tls"}}}]},
    "untrustedCaDenialCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "untrusted-ca-denial"}}}]},
    "workloadJwtAuthenticationCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "workload-jwt-authentication"}}}]},
    "audienceDenialCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "audience-denial"}}}]},
    "subjectDenialCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "subject-denial"}}}]},
    "exactScopeLeaseCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "exact-scope-lease"}}}]},
    "crossTenantDenialCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "cross-tenant-denial"}}}]},
    "scopeEscalationDenialCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "scope-escalation-denial"}}}]},
    "rotationWithoutRestartCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "rotation-without-restart"}}}]},
    "revocationCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "revocation"}}}]},
    "auditCompletenessCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "audit-completeness"}}}]},
    "brokerOutageFailClosedCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "broker-outage-fail-closed"}}}]},
    "brokerRecoveryCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "broker-recovery"}}}]},
    "secretRedactionCheck": {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"id": {"const": "secret-redaction"}}}]}
  }
}
