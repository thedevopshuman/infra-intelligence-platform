{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:investigation-job-status:v1alpha1",
  "title": "Infrastructure Intelligence Investigation Job Status",
  "description": "Bounded tenant-scoped dispatch state for one immutable investigation request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "InvestigationJobStatus"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "updatedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^inv_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "updatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestDigest", "state", "queuedAt", "attempts"],
      "properties": {
        "requestDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "state": {
          "type": "string",
          "enum": ["queued", "running", "cancellation-requested", "completed", "failed", "cancelled"]
        },
        "queuedAt": {"type": "string", "format": "date-time"},
        "availableAt": {"type": "string", "format": "date-time"},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 1000},
        "startedAt": {"type": "string", "format": "date-time"},
        "heartbeatAt": {"type": "string", "format": "date-time"},
        "leaseExpiresAt": {"type": "string", "format": "date-time"},
        "completedAt": {"type": "string", "format": "date-time"},
        "reportRef": {
          "type": "string",
          "format": "uri-reference",
          "pattern": "^investigation://",
          "maxLength": 2048
        },
        "lastErrorCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,127}$"
        },
        "cancellation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedBy", "requestedAt", "reasonCode"],
          "properties": {
            "requestedBy": {"type": "string", "minLength": 1, "maxLength": 256},
            "requestedAt": {"type": "string", "format": "date-time"},
            "reasonCode": {
              "type": "string",
              "enum": ["operator-requested", "incident-resolved", "superseded"]
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"spec": {"properties": {"state": {"const": "queued"}}}}},
      "then": {
        "properties": {"spec": {
          "required": ["availableAt"],
          "not": {"anyOf": [
            {"required": ["startedAt"]}, {"required": ["heartbeatAt"]},
            {"required": ["leaseExpiresAt"]}, {"required": ["completedAt"]},
            {"required": ["reportRef"]}, {"required": ["cancellation"]}
          ]}
        }}
      }
    },
    {
      "if": {"properties": {"spec": {"properties": {"state": {"enum": ["running", "cancellation-requested"]}}}}},
      "then": {
        "properties": {"spec": {
          "required": ["startedAt", "heartbeatAt", "leaseExpiresAt"],
          "not": {"anyOf": [
            {"required": ["availableAt"]}, {"required": ["completedAt"]},
            {"required": ["reportRef"]}
          ]}
        }}
      }
    },
    {
      "if": {"properties": {"spec": {"properties": {"state": {"enum": ["completed", "failed", "cancelled"]}}}}},
      "then": {
        "properties": {"spec": {
          "required": ["completedAt"],
          "not": {"anyOf": [
            {"required": ["availableAt"]}, {"required": ["heartbeatAt"]},
            {"required": ["leaseExpiresAt"]}
          ]}
        }}
      }
    },
    {
      "if": {"properties": {"spec": {"properties": {"state": {"enum": ["cancellation-requested", "cancelled"]}}}}},
      "then": {"properties": {"spec": {"required": ["cancellation"]}}},
      "else": {"properties": {"spec": {"not": {"required": ["cancellation"]}}}}
    }
  ]
}
