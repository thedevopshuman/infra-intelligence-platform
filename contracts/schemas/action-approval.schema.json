{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:action-approval:v1alpha1",
  "title": "Infrastructure Intelligence Action Approval",
  "type": "object", "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "ActionApproval"},
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "tenantId", "approverId", "decidedAt"],
      "properties": {
        "id": {"type": "string", "pattern": "^apr_[a-f0-9]{32}$"},
        "tenantId": {"type": "string", "minLength": 1, "maxLength": 128},
        "approverId": {"type": "string", "minLength": 1, "maxLength": 256},
        "decidedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object", "additionalProperties": false,
      "required": ["proposalId", "decision", "rationale", "policySnapshotRef"],
      "properties": {
        "proposalId": {"type": "string", "pattern": "^act_[a-f0-9]{32}$"},
        "proposalDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "decision": {"type": "string", "enum": ["approved", "rejected"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 4096},
        "policySnapshotRef": {"type": "string", "format": "uri-reference", "minLength": 1, "maxLength": 2048},
        "policyInputDigest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    }
  }
}
