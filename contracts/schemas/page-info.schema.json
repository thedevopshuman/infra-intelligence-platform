{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:page-info:v1alpha1",
  "title": "Infrastructure Intelligence Page Information",
  "type": "object",
  "additionalProperties": false,
  "required": ["limit", "hasMore"],
  "properties": {
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "hasMore": {"type": "boolean"},
    "nextCursor": {
      "type": "string",
      "pattern": "^p1\\.[A-Za-z0-9_-]+$",
      "maxLength": 2048
    }
  },
  "allOf": [
    {
      "if": {"properties": {"hasMore": {"const": true}}},
      "then": {"required": ["nextCursor"]},
      "else": {"not": {"required": ["nextCursor"]}}
    }
  ]
}
