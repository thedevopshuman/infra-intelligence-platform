{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:credential-lease:v1alpha1",
  "title": "Credential Lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.broker/v1alpha1"},
    "kind": {"const": "CredentialLease"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "issuedAt"],
      "properties": {
        "requestId": {"type": "string", "pattern": "^crq_[a-f0-9]{32}$"},
        "issuedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scheme", "secret", "expiresAt"],
      "properties": {
        "scheme": {"const": "bearer"},
        "secret": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "pattern": "^[!-~]+$",
          "writeOnly": true
        },
        "expiresAt": {"type": "string", "format": "date-time"}
      }
    }
  }
}
