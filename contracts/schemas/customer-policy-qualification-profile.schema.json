{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-policy-qualification-profile:v1alpha1",
  "title": "Customer Policy Qualification Profile",
  "description": "Protected reviewed allow and deny cases for qualifying one customer external policy endpoint and immutable bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerPolicyQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$", "maxLength": 64},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "identity", "cases", "objective"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^https://", "maxLength": 2048},
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "actorId", "roles"],
          "properties": {
            "tenantId": {"$ref": "#/$defs/tenantId"},
            "actorId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$", "not": {"const": "anonymous"}},
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,63}$"}
            }
          }
        },
        "cases": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/case"}
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestTimeoutSeconds", "maximumResponseBytes", "maximumDecisionLatencyMilliseconds", "maximumProfileAgeSeconds"],
          "properties": {
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
            "maximumResponseBytes": {"type": "integer", "minimum": 1024, "maximum": 1048576},
            "maximumDecisionLatencyMilliseconds": {"type": "integer", "minimum": 1, "maximum": 30000},
            "maximumProfileAgeSeconds": {"type": "integer", "minimum": 3600, "maximum": 7776000}
          }
        }
      }
    }
  },
  "$defs": {
    "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
    "action": {"type": "string", "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$", "maxLength": 128},
    "reasonCode": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)+$", "maxLength": 128, "not": {"const": "policy.unavailable"}},
    "snapshotRef": {"type": "string", "pattern": "^policy://[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}/snapshots/[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,511}$", "maxLength": 2048},
    "jsonValue": {
      "oneOf": [
        {"type": "null"},
        {"type": "boolean"},
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "string", "maxLength": 2048},
        {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/jsonValue"}},
        {"type": "object", "maxProperties": 32, "additionalProperties": {"$ref": "#/$defs/jsonValue"}}
      ]
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "resource", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
        "action": {"$ref": "#/$defs/action"},
        "resource": {
          "type": "object",
          "required": ["tenantId"],
          "maxProperties": 32,
          "properties": {"tenantId": {"$ref": "#/$defs/tenantId"}},
          "additionalProperties": {"$ref": "#/$defs/jsonValue"}
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "reasonCode", "policySnapshotRef"],
          "properties": {
            "allowed": {"type": "boolean"},
            "reasonCode": {"$ref": "#/$defs/reasonCode"},
            "policySnapshotRef": {"$ref": "#/$defs/snapshotRef"}
          }
        }
      }
    }
  }
}
