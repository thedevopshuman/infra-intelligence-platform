{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:customer-oidc-qualification-profile:v1alpha1",
  "title": "Customer OIDC Qualification Profile",
  "description": "Protected expected identity and OIDC browser/verifier configuration for one customer qualification run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "CustomerOidcQualificationProfile"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "reviewedAt"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "reviewedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "oidc", "objective"],
      "properties": {
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tenantId", "actorId", "roles"],
          "properties": {
            "tenantId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"},
            "actorId": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/@-]{0,255}$"},
            "roles": {
              "type": "array",
              "minItems": 1,
              "maxItems": 32,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9._:-]{0,63}$"}
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issuer", "audience", "discoveryUrl", "jwksUrl", "actorClaim", "tenantClaim", "rolesClaim", "browser"],
          "properties": {
            "issuer": {"$ref": "#/$defs/httpsUrl"},
            "audience": {"type": "string", "pattern": "^[^\\s\\x00-\\x1f]{1,512}$"},
            "discoveryUrl": {"$ref": "#/$defs/httpsUrl"},
            "jwksUrl": {"$ref": "#/$defs/httpsUrl"},
            "actorClaim": {"$ref": "#/$defs/claim"},
            "tenantClaim": {"$ref": "#/$defs/claim"},
            "rolesClaim": {"$ref": "#/$defs/claim"},
            "browser": {
              "type": "object",
              "additionalProperties": false,
              "required": ["clientId", "authorizationEndpoint", "tokenEndpoint", "redirectUri", "scopes", "providerLabel"],
              "properties": {
                "clientId": {"type": "string", "pattern": "^[^\\s\\x00-\\x1f]{1,256}$"},
                "authorizationEndpoint": {"$ref": "#/$defs/httpsUrl"},
                "tokenEndpoint": {"$ref": "#/$defs/httpsUrl"},
                "redirectUri": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
                "providerLabel": {"type": "string", "pattern": "^[^\\x00-\\x1f\\x7f]{1,64}$"},
                "scopes": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "contains": {"const": "openid"},
                  "items": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]{1,128}$"}
                }
              }
            }
          }
        },
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumRemainingTokenSeconds", "maximumTokenLifetimeSeconds", "requestTimeoutMilliseconds", "maximumResponseBytes"],
          "properties": {
            "minimumRemainingTokenSeconds": {"type": "integer", "minimum": 30, "maximum": 3600},
            "maximumTokenLifetimeSeconds": {"type": "integer", "minimum": 300, "maximum": 86400},
            "requestTimeoutMilliseconds": {"type": "integer", "minimum": 100, "maximum": 30000},
            "maximumResponseBytes": {"type": "integer", "minimum": 4096, "maximum": 262144}
          }
        }
      }
    }
  },
  "$defs": {
    "httpsUrl": {"type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048},
    "claim": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]{0,255}$"}
  }
}
