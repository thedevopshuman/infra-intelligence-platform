{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.iip.local/v1alpha1/otlp-logs-evidence.schema.json",
  "title": "OTLP Logs Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "OtlpLogsEvidence"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "integrationId", "channelId", "receivedAt"],
      "properties": {
        "tenantId": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
        "integrationId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "channelId": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{2,127}$"},
        "receivedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signal", "protocol", "timeRange", "records", "summary"],
      "properties": {
        "signal": {"const": "logs"},
        "protocol": {"const": "otlp/http-protobuf"},
        "timeRange": {"$ref": "#/$defs/timeRange"},
        "records": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/record"}},
        "summary": {"$ref": "#/$defs/summary"}
      }
    }
  },
  "$defs": {
    "timeRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "resourceRef", "timestamp", "severity", "serviceName", "body", "attributes"],
      "properties": {
        "id": {"type": "string", "pattern": "^log_[a-f0-9]{32}$"},
        "resourceRef": {"type": "string", "pattern": "^res_[a-f0-9]{32}$"},
        "timestamp": {"type": "string", "format": "date-time"},
        "observedTimestamp": {"type": "string", "format": "date-time"},
        "severity": {"enum": ["trace", "debug", "info", "warn", "error", "fatal", "unspecified"]},
        "serviceName": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,127}$"},
        "body": {"type": "string", "minLength": 1, "maxLength": 4096},
        "attributes": {
          "type": "object",
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_.:/-]{0,127}$"},
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\x00-\\x1F\\x7F]+$"}
        },
        "traceId": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "spanId": {"type": "string", "pattern": "^[a-f0-9]{16}$"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["serviceCount", "recordCount", "errorCount"],
      "properties": {
        "serviceCount": {"type": "integer", "minimum": 1, "maximum": 128},
        "recordCount": {"type": "integer", "minimum": 1, "maximum": 1000},
        "errorCount": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    }
  }
}
