          "range": false,
          "refId": "A"
        }
      ],
      "title": "How much usage?",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "iip-prometheus"
      },
      "description": "Calculated estimate for priced requests. This is not invoice cost.",
      "fieldConfig": {
        "defaults": {
          "decimals": 6,
          "unit": "currencyUSD"
