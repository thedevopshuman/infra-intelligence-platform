{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:iip:contracts:event-delivery-health-report:v1alpha1",
  "title": "Infrastructure Intelligence Event Delivery Health Report",
  "description": "Tenant-scoped transactional-outbox backlog and quarantine state without event payloads or provider responses.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "iip.platform/v1alpha1"},
    "kind": {"const": "EventDeliveryHealthReport"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "evaluatedAt"],
      "properties": {
        "tenantId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,127}$"
        },
        "evaluatedAt": {"type": "string", "format": "date-time"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "delivery", "quarantine"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["healthy", "backlogged", "degraded"]
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pendingEvents",
            "inFlightEvents",
            "retryingEvents",
            "quarantinedEvents"
          ],
          "properties": {
            "pendingEvents": {"$ref": "#/$defs/counter"},
            "inFlightEvents": {"$ref": "#/$defs/counter"},
            "retryingEvents": {"$ref": "#/$defs/counter"},
            "quarantinedEvents": {"$ref": "#/$defs/counter"},
            "oldestPendingEventAgeSeconds": {"$ref": "#/$defs/counter"}
          }
        },
        "quarantine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["limit", "hasMore", "items"],
          "properties": {
            "limit": {"type": "integer", "minimum": 1, "maximum": 50},
            "hasMore": {"type": "boolean"},
            "items": {
              "type": "array",
              "maxItems": 50,
              "items": {"$ref": "#/$defs/quarantinedEvent"}
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "delivery": {
                "properties": {"pendingEvents": {"const": 0}}
              }
            }
          },
          "then": {
            "properties": {
              "delivery": {
                "not": {"required": ["oldestPendingEventAgeSeconds"]}
              }
            }
          },
          "else": {
            "properties": {
              "delivery": {"required": ["oldestPendingEventAgeSeconds"]}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "healthy"}}},
          "then": {
            "properties": {
              "delivery": {
                "properties": {
                  "pendingEvents": {"const": 0},
                  "inFlightEvents": {"const": 0},
                  "retryingEvents": {"const": 0},
                  "quarantinedEvents": {"const": 0}
                }
              },
              "quarantine": {
                "properties": {
                  "hasMore": {"const": false},
                  "items": {"maxItems": 0}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "backlogged"}}},
          "then": {
            "properties": {
              "delivery": {
                "properties": {
                  "pendingEvents": {"minimum": 1},
                  "quarantinedEvents": {"const": 0}
                }
              },
              "quarantine": {
                "properties": {
                  "hasMore": {"const": false},
                  "items": {"maxItems": 0}
                }
              }
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "degraded"}}},
          "then": {
            "properties": {
              "delivery": {
                "properties": {"quarantinedEvents": {"minimum": 1}}
              },
              "quarantine": {"properties": {"items": {"minItems": 1}}}
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "counter": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "quarantinedEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outboxId",
        "eventId",
        "eventSource",
        "eventType",
        "subject",
        "attempts",
        "quarantinedAt",
        "lastErrorCode"
      ],
      "properties": {
        "outboxId": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
        "eventSource": {"type": "string", "minLength": 1, "maxLength": 512},
        "eventType": {
          "type": "string",
          "pattern": "^io\\.iip\\.[a-z0-9.-]+\\.v[1-9][0-9]*$",
          "maxLength": 256
        },
        "subject": {"type": "string", "minLength": 1, "maxLength": 512},
        "attempts": {"type": "integer", "minimum": 1, "maximum": 1000},
        "quarantinedAt": {"type": "string", "format": "date-time"},
        "lastErrorCode": {"const": "event.publisher.unavailable"}
      }
    }
  }
}
